#!/usr/bin/env zsh
# cs: start, go to or resume a Claude Code session in ~/.local/src, from any
# folder. Needs fzf, git and rg; jq for the recent and open sessions and the
# limits of each profile; herdr for the open sessions. Claude runs in the checkout, and your shell stays in
# its folder. An account <name> is the config home ~/.claude-<name>.

# Pick in ~/.local/src: a checkout ~/.local/src/<owner>/<repo>/<folder>, or a
# repo folder in the tree layout, starts a new Claude Code session there, with
# the profile in the prompt, the one with the lowest use when cs opens, or the
# one that tab and shift-tab select; an open session goes to its herdr pane; a
# recent one resumes in its folder with the account that owns it. ctrl-t on any
# row opens a new shell in its folder.
# The other args go to claude, except, in any place, --<name> for the account
# ~/.claude-<name>, such as --work, or --config <path> for any config home: it
# is then the profile in the prompt. Sessions in a home that is not
# ~/.claude or ~/.claude-<name> also show, and resume with that home.
# One match for the query skips fzf. A first arg that starts with - is a
# claude arg, so `cs -c` has no query. README.md has lines for ~/.zshrc that
# open cs in each new herdr pane that has the focus. While it shows, _cs_refresh
# gets live limits in the background.
# Two settings, exported in ~/.zshrc or set before the command: CS_LAYOUT is
# tree, the default, for each repo, which the right arrow opens to its branches
# and their sessions and the left arrow closes, or flat for the checkouts, then
# the open sessions, then the recent ones.
# CS_BRANCH_INFO holds the extra branch data to show, none by default: base for
# the commits ahead and behind the default branch, merged for a pushed branch
# with no commit that the default branch lacks, or gone when its upstream is
# gone, pr for its pull request in the preview.
cs() {
  emulate -L zsh
  local src="$HOME/.local/src" layout=${CS_LAYOUT:-tree} query out key acct pr home REPLY
  local -a args
  while (( $# )); do
    case $1 in
      --config) (( $# > 1 )) && [[ -n $2 ]] || { print -u2 'cs: --config needs a path'; return 1; }
        home=$2; shift ;;
      --config=?*) home=${${1#--config=}/#\~/$HOME} ;;
      --config=) print -u2 'cs: --config needs a path'; return 1 ;;
      --?*) if [[ -d $HOME/.claude-${1#--} ]]; then _cs_acct $HOME/.claude-${1#--}; acct=$REPLY; else args+=("$1"); fi ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]}"
  # An unknown home must not reach claude: it would make a new empty home.
  if [[ -n $home ]]; then
    [[ -d $home ]] || { print -u2 "cs: --config needs a folder that exists, not $home"; return 1; }
    _cs_acct "$home"
    acct=$REPLY
  fi
  [[ ${1-} == -* ]] || { query=${1-}; (( $# )) && shift; }
  local -a dirs=("$src"/*/*/*(N/)) f run=(claude) info=(${=CS_BRANCH_INFO-}) known=(base merged pr) bad opts
  [[ $layout == (tree|flat) ]] || { print -u2 "cs: CS_LAYOUT is tree or flat, not $layout"; return 1; }
  bad=(${info:|known})
  (( $#bad )) && { print -u2 "cs: CS_BRANCH_INFO takes base, merged and pr, not $bad"; return 1; }
  (( $#dirs )) || { print -u2 "cs: no checkout in $src"; return 1; }
  # A sort by match would break the tree, and a scroll to a match in the faint
  # path at the end of a long row would hide its label and title. With no sort,
  # the cursor stays where it was when you type, so _cs_key moves it to the first
  # match. Also with no sort, a fuzzy match in another repo would come first, so
  # a query is exact.
  local tmp ret feed pick job
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-cs.XXXXXX") || return 1
  {
    _cs_rows "$src" "$layout" "$info" "${(M)acct:#/*}" "${dirs[@]}" > $tmp/rows
    : > $tmp/open
    print -r -- $layout > $tmp/layout
    # A flag fixes the selection. The default home has an empty account here.
    # The file flag keeps the home listed after tab has replaced the file fixed.
    if [[ -n $acct || -n $home ]]; then
      print -r -- "${acct:-default}" > $tmp/fixed
      cp $tmp/fixed $tmp/flag
    fi
    # A query searches every row, as a closed repo would hide its sessions.
    [[ -n $query ]] && : > $tmp/all
    # fzf runs each key in a new process, which sources this script for _cs_key.
    print -rl -- "#!$commands[zsh] -f" "source ${(q)${functions_source[cs]:a}} --cs-key" "_cs_key ${(q)tmp} \"\$@\"" > $tmp/ctl
    chmod +x $tmp/ctl
    _cs_key $tmp read-limits
    _cs_pick $tmp
    feed=$tmp/first
    _cs_key $tmp view > $feed
    cp $tmp/title $tmp/shown
    opts=(--no-hscroll --header="$(<$tmp/title)" --header-border=line --ellipsis= --prompt="$(_cs_prompt $tmp)"
      --bind="result:transform:$tmp/ctl result"
      --bind="resize:transform:$tmp/ctl resize"
      --bind="ctrl-/:transform:$tmp/ctl preview"
      --bind="tab:transform:$tmp/ctl profile 1"
      --bind="shift-tab:transform:$tmp/ctl profile -1")
    [[ $layout == tree ]] && opts+=(--exact --no-sort
      --bind="change:transform:$tmp/ctl change"
      --bind="right:transform:$tmp/ctl right {6} {7} {8}"
      --bind="left:transform:$tmp/ctl left {6} {7} {8}")
    (( ${info[(Ie)pr]} )) &&
      pr='(cd {2} && gh pr view --json number,state,title,url -t "#{{.number}} {{.state}} {{.title}}  {{.url}}{{\"\\n\\n\"}}" 2> /dev/null); '
    # fzf takes a socket only with a .sock name, and fails to start on a path
    # past the 103 bytes that macOS allows.
    if (( $#tmp + 9 < 104 )); then
      opts+=(--listen=$tmp/fzf.sock)
      { _cs_refresh $tmp; : > $tmp/ended; } < /dev/null > /dev/null 2>&1 &!
      job=$!
    fi
    _cs_pane $tmp ${#${(0)"$(<$feed)"}}
    print -r -- "$REPLY" > $tmp/pane
    out=$(fzf --read0 --ansi --highlight-line --delimiter=$'\t' --with-nth=3 --accept-nth=1,2,4,5 --expect=ctrl-t $opts \
        --query="$query" ${query:+--select-1} ${query:+--exit-0} --height=100% --layout=reverse \
        --border=none --info=inline --gutter=' ' --pointer='▌' \
        --color='bg+:238,hl:215,hl+:215:bold,pointer:117,prompt:117,query:255,info:243,header:243,footer:243,border:238,preview-border:238,list-border:238,header-border:238,separator:238,scrollbar:240,spinner:117,marker:114' \
        --footer="$(_cs_hint $layout $tmp)" \
        --preview-window="$REPLY" \
        --preview="$tmp/ctl limits {1}; "'case {1} in
          s) herdr agent read {2} --lines "$('"$tmp"'/ctl room)" ;;
          r) rg -F "\"last-prompt\"" {2} | jq -r "select(.type == \"last-prompt\") | \"› \" + (.lastPrompt // \"\" | gsub(\"\\n\"; \" \"))" | uniq | tail -n "$('"$tmp"'/ctl room)" ;;
          c) '"$pr"'git --no-optional-locks -C {2} -c color.ui=always -c color.status.branch=117 -c color.status.remotebranch=245 -c color.status.added=114 -c color.status.changed=180 -c color.status.untracked=245 status -sb; echo; git -C {2} log --color=always --format="%C(180)%h%C(reset) %s" -n "$FZF_PREVIEW_LINES" ;;
          p) for d in {2}/*/; do
               if git -C "$d" worktree list 2> /dev/null; then echo; git -C "$d" log --color=always --format="%C(180)%h%C(reset) %s" -n "$FZF_PREVIEW_LINES"; break; fi
             done ;;
        esac' < $feed)
    ret=$?
    _cs_chosen $tmp
    pick=$REPLY
  } always {
    # cs can stay open for days, and the pid of an ended job can be another process.
    [[ -n $job && ! -e $tmp/ended ]] && kill $job 2> /dev/null
    rm -rf -- $tmp 2> /dev/null
  }
  (( ret )) && { (( ret == 1 )) && [[ -n $query ]] && print -u2 "cs: no match for $query"; return 1; }
  key=${out%%$'\n'*} f=("${(@ps:\t:)${out#*$'\n'}}")
  [[ $key == ctrl-t ]] && { cd "$f[3]" && exec "${SHELL:-zsh}"; return; }
  case $f[1] in
    s) [[ -n ${HERDR_ENV-} ]] || { print -u2 'cs: go to an open session from inside herdr'; return 1; }
      herdr agent focus "$f[2]" > /dev/null; return ;;
    r) pick=${f[4]:-default}
      set -- --resume "${f[2]:t:r}" "$@" ;;
  esac
  # Claude Code keys the login to CLAUDE_CONFIG_DIR, so the default home needs it
  # unset: set to ~/.claude, it is another login. An empty pick has no profile
  # to use.
  case $pick in
    default) unset CLAUDE_CONFIG_DIR ;;
    /*) export CLAUDE_CONFIG_DIR=$pick ;;
    ?*) export CLAUDE_CONFIG_DIR=$HOME/.claude-$pick ;;
  esac
  cd "$f[3]" && $run "$@"
}

# The account of the config home $1, in REPLY: empty for ~/.claude, the
# default; <name> for ~/.claude-<name>; else the absolute path of the home, as
# also for ~/.claude-default, because default names only ~/.claude.
_cs_acct() {
  emulate -L zsh
  REPLY=${1:a}
  if [[ $REPLY == $HOME/.claude ]]; then REPLY=
  elif [[ ${REPLY:h} == $HOME && ${REPLY:t} == .claude-?* && ${REPLY:t} != .claude-default ]]; then REPLY=${${REPLY:t}#.claude-}
  fi
}

# Records for cs, after the folder, the layout, the extra branch data and a
# config home that is not ~/.claude or ~/.claude-<name>, or an empty arg: kind,
# target, empty display text, folder, account, then the fields that _cs_trow
# lists, which _cs_view makes into the table. Kind c is a
# checkout with its changed files and commits ahead and behind, the one with
# the latest Claude session first; s is a session open in herdr, the ones that
# wait for you first, as solid blocks; r is one of the 10 latest sessions that
# is not running, in a muted color, so that it does not compete with them;
# p, only in the tree layout, is a repo folder. The target is the checkout, the
# herdr pane, the transcript or the repo folder. _cs_tree gives the tree order.
# Transcripts are an internal format: read only the folder, entrypoint, titles
# and prompts, so a format change hides a row or a title but breaks no resume.
_cs_rows() {
  emulate -L zsh
  zmodload -F zsh/stat b:zstat
  zmodload zsh/datetime
  local src=$1 layout=$2 home=$4 r d t k title acct age s up REPLY
  local text dim faint bold cyan th amber green rose violet band reset
  _cs_palette
  local -i i
  local -a info=(${=3})
  shift 4
  local -A color=(blocked '1;38;5;232;48;5;203' done '1;38;5;232;48;5;114' idle '38;5;245' working '38;5;221') glyph=(blocked '!' done ✓ idle ○ working ●)
  local -A folder entry custom ai asked used heads notes base
  local -a sessions files picked recent running records kids f g st ab lr note mtime parts order
  if (( ${+commands[jq]} )); then
    (( ${+commands[herdr]} )) &&
      sessions=(${(f)"$(herdr agent list 2>/dev/null | jq -r --arg src "$src/" '
        [.result.agents[]? | select((.cwd // "") | startswith($src))]
        | sort_by({blocked: 0, done: 1, idle: 2, working: 3}[.agent_status // ""] // 4)
        | .[] | [.pane_id, (.cwd | ltrimstr($src)), .agent_status, .terminal_title_stripped] | @tsv')"})
    # Each running session has a sessions/<pid>.json in its config home.
    records=($HOME/.claude(|-*)/sessions/*.json(N))
    [[ -n $home ]] && records+=($home/sessions/*.json(N))
    (( $#records )) &&
      for r in ${(f)"$(jq -r '"\(.pid) \(.sessionId)"' $records 2>/dev/null)"}; do
        kill -0 ${r%% *} 2>/dev/null && running+=(${r#* })
      done
  fi
  # The 10 latest sessions over all config homes that do not run, as the /resume
  # picker lists them: no claude -p or SDK session, none without a prompt. The
  # title is your last name for it, else its last AI title, else its last prompt.
  # The first rg reads only the head of each file; the second reads at most 20 files.
  files=($HOME/.claude(|-*)/projects/${src//[^[:alnum:]]/-}-*/*.jsonl(N.om))
  # A glob sorts only its own files, so sort again with those of the other home.
  if [[ -n $home ]]; then
    files+=($home/projects/${src//[^[:alnum:]]/-}-*/*.jsonl(N.))
    parts=()
    for t in $files; do
      zstat -A mtime +mtime -- $t
      parts+=("$mtime[1] $t")
    done
    files=(${(u)${${(On)parts}#* }})
  fi
  (( $#files && ${+commands[rg]} && ${+commands[jq]} )) || files=()
  (( $#files )) &&
    for r in ${(f)"$(rg -m3 -o --with-filename --no-line-number '"(cwd|entrypoint)":"[^"]*"' $files)"}; do
      t=${r%%:*}
      r=${r#*:}
      case $r in
        \"cwd*) : ${folder[$t]:=${${r#*\":\"}%\"}} ;;
        *) : ${entry[$t]:=${${r#*\":\"}%\"}} ;;
      esac
    done
  # Checkouts and repos by their latest session in any account, newest first,
  # then by name.
  for (( i = 1; i <= $#files; i++ )); do
    t=$files[i]
    [[ $folder[$t] == $src/* ]] || continue
    parts=(${(s:/:)${folder[$t]#$src/}})
    (( $#parts >= 3 )) && : ${used[$src/${(j:/:)parts[1,3]}]:=$i}
    : ${used[$src/${(j:/:)parts[1,2]}]:=$i}
  done
  for d; order+=("${used[$d]:-999999} $d")
  set -- ${${(on)order}#* }
  for t in $files; do
    (( $#picked < 20 )) || break
    (( ${running[(Ie)${t:t:r}]} )) && continue
    [[ $entry[$t] != sdk* && $folder[$t] == $src/* && -d $folder[$t] ]] && picked+=($t)
  done
  (( $#picked )) &&
    for r in ${(f)"$(rg -o --with-filename --no-line-number '"(customTitle|aiTitle|lastPrompt)":"(\\.|[^"\\])*"' $picked)"}; do
      t=${r%%:*}
      r=${r#*:}
      case $r in
        \"customTitle*) custom[$t]=${${r#*\":\"}%\"} ;;
        \"aiTitle*) ai[$t]=${${r#*\":\"}%\"} ;;
        *) asked[$t]=${${r#*\":\"}%\"} ;;
      esac
    done
  for t in $picked; do
    title=${custom[$t]:-${ai[$t]:-$asked[$t]}}
    [[ -n $title ]] || continue
    (( $#recent < 10 )) || break
    title=${${title//\\n/ }//\\\"/\"}
    _cs_acct ${t%/projects/*}
    acct=$REPLY
    zstat -A mtime +mtime -- $t
    (( age = EPOCHSECONDS - mtime[1] ))
    if (( age < 3600 )); then age="$(( age / 60 ))m"
    elif (( age < 86400 )); then age="$(( age / 3600 ))h"
    else age="$(( age / 86400 ))d"; fi
    recent+=("$t"$'\t'"${folder[$t]#$src/}"$'\t'"${title[1,100]}"$'\t'"$folder[$t]"$'\t'"$acct"$'\t'"$age")
  done
  # One row for each session: kind, target, label, its color, path under
  # ~/.local/src, title, folder, account, age.
  for r in $sessions; do
    f=("${(@ps:\t:)r}")
    g=(s "$f[1]" "${glyph[$f[3]]:-○} $f[3]" "${color[$f[3]]:-38;5;245}" "$f[2]" "$f[4]" "$src/$f[2]" "")
    kids+=("${(pj:\t:)g}")
  done
  for r in $recent; do
    f=("${(@ps:\t:)r}")
    g=(r "$f[1]" "↺ resume" '38;5;103' "$f[2]" "$f[3]" "$f[4]" "$f[5]" "$f[6]")
    kids+=("${(pj:\t:)g}")
  done

  # Without --no-optional-locks, git status takes index.lock, and a git commit
  # of an agent in that checkout can fail at the same moment. The default
  # branch is origin/HEAD, which all checkouts of a repo share.
  for d; do
    st=(${(f)"$(git --no-optional-locks -C "$d" status --porcelain=v2 --branch 2>/dev/null)"})
    ab=(${=${${(M)st:#\# branch.ab *}#\# branch.ab }})
    note=(${${st:#\#*}:+$amber±${#${st:#\#*}}})
    (( ${ab[1]#+} )) && note+=("$green↑${ab[1]#+}")
    (( ${ab[2]#-} )) && note+=("$rose↓${ab[2]#-}")
    notes[$d]="${note:+$note$reset}"
    heads[$d]=${${(M)st:#\# branch.head *}#\# branch.head }
    (( ${info[(Ie)base]} + ${info[(Ie)merged]} )) || continue
    k=${d:h}
    : ${base[$k]:=$(git -C "$d" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)}
    [[ -n $base[$k] && $heads[$d] != ${base[$k]#*/} ]] || continue
    # lr: the commits behind, then ahead of, the default branch.
    lr=(${=$(git -C "$d" rev-list --left-right --count "$base[$k]...HEAD" 2>/dev/null)})
    note=()
    if (( ${info[(Ie)base]} )); then
      s=
      (( lr[2] )) && s+=" +$lr[2]"
      (( lr[1] )) && s+=" -$lr[1]"
      [[ -n $s ]] && note+=("${base[$k]#*/}$s")
    fi
    # Only a pushed branch: a new one has no upstream, or the default branch as
    # its upstream when it was made from origin/<default>, and it also has no
    # commit that the default branch lacks.
    up=${${(M)st:#\# branch.upstream *}#\# branch.upstream }
    if (( ${info[(Ie)merged]} )) && [[ -n $up && $up != $base[$k] ]]; then
      if (( $#lr == 2 && ! lr[2] && lr[1] )); then note+=(merged)
      elif [[ -z ${(M)st:#\# branch.ab *} ]]; then note+=(gone)
      fi
    fi
    (( $#note )) && notes[$d]+="${notes[$d]:+ }$dim$note$reset"
  done

  [[ $layout == tree ]] && { _cs_tree "$@"; return; }
  # The flat layout: each checkout, then each session, none with parents.
  for d; printf '%s\t%s\t\t%s\t\t\t\t\t0\tr\t%s\t%s\t%s\t%s\t%s\t\t\t%s\0' c "$d" "$d" \
    "${d:h:t}" "${heads[$d]:-${d:t}}" '+ new' '38;5;117' "$notes[$d]" "${d#$src/}"
  for r in $kids; _cs_srow "" 0 "${(@ps:\t:)r}"
}

# The tree layout of _cs_rows, after its checkouts. It reads and changes the
# locals of _cs_rows: src, kids, used, heads and notes. It writes records, and
# _cs_view makes the table from them. Each repo comes in order: first the repos
# with a session that waits for you (blocked or done), then the one with the
# latest session, then by name. Under it, the sessions in its folder, then each
# checkout, the primary clone first, with the sessions in it. A repo with one
# checkout and no session of its own is one row. A checkout shows its branch,
# and ⚠ with the folder when the branch does not match the folder name. A repo
# opens to its checkouts and its own sessions, and a checkout to its sessions.
_cs_tree() {
  emulate -L zsh
  local d k c
  local -i i
  local -A names count own waits
  local -a repos order ds f parts
  for d; do
    k=${${d:h}#$src/}
    names[$d]=${heads[$d]:-${d:t}}
    [[ ${names[$d]//\//-} == ${d:t} ]] || names[$d]+=" ⚠ ${d:t}"
    count[$k]=$(( ${count[$k]:-0} + 1 ))
    repos+=($k)
  done
  # Each session row starts with its group: the checkout it is in, else its
  # repo, which then has a session of its own.
  for (( i = 1; i <= $#kids; i++ )); do
    f=("${(@ps:\t:)kids[i]}")
    parts=(${(s:/:)f[5]})
    k=${(j:/:)parts[1,3]}
    (( $#parts >= 3 && ${argv[(Ie)$src/$k]} )) || { k=${(j:/:)parts[1,2]}; own[$k]=1; }
    kids[i]=$k$'\t'$kids[i]
    repos+=(${(j:/:)parts[1,2]})
    [[ $f[1] == s && $f[3] == *' '(blocked|done) ]] || continue
    used[$src/${(j:/:)parts[1,2]}]=0
    for c in $k ${(j:/:)parts[1,2]}; do
      [[ $waits[$c] == blocked ]] || waits[$c]=${f[3]#* }
    done
  done
  for k in ${(u)repos}; order+=("${used[$src/$k]:-999999} $k")
  for k in ${${(on)order}#* }; do
    ds=()
    for d; do
      [[ ${d:h} == $src/$k ]] || continue
      if [[ -d $d/.git ]]; then ds=($d $ds); else ds+=($d); fi
    done
    if (( $#ds == 1 )) && [[ -z $own[$k] ]]; then
      d=$ds[1]
      _cs_trow c "$d" r "${k:t}" "$names[$d]" "$notes[$d]" "${d#$src/}" "${d#$src/}" 0 ""
      continue
    fi
    _cs_trow p "$src/$k" r "${k:t}" "" "" "$k" "$k" 0 ""
    for d in $ds; _cs_trow c "$d" b "$names[$d]" "" "$notes[$d]" "${d#$src/}" "${d#$src/}" 1 "$k"
  done
}

# The record of a repo or checkout row, then of the session rows of its group:
# $1 kind, $2 folder, $3 style (r repo, b branch), $4 name, $5 branch after a
# repo name, $6 note, $7 path, $8 id, which is also the group, $9 depth, $10 the
# ids of its parents, joined by |. It reads kids, waits and the color tables of
# its callers. After the fields of _cs_rows, with an empty display field, come
# the id, parents, 1 for a row with rows under it, depth, style, name, branch,
# status, its color, note, age, account and path. The status of a repo or
# checkout is the most urgent session under it, which shows while it is closed.
_cs_trow() {
  emulate -L zsh
  local r has w=$waits[$8]
  local -a rows=(${(M)kids:#$8$'\t'*})
  [[ $1 == p || $#rows -gt 0 ]] && has=1
  printf '%s\t%s\t\t%s\t\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t\t\t%s\0' "$1" "$2" "$2" \
    "$8" "${10}" "$has" "$9" "$3" "$4" "$5" "${w:+$glyph[$w] $w}" "${w:+$color[$w]}" "$6" "$7"
  for r in $rows; _cs_srow "${10:+${10}|}$8" $(( $9 + 1 )) "${(@ps:\t:)${r#*$'\t'}}"
}

# The record of a session row: $1 the ids of its parents, $2 its depth, then the
# fields of a session row of _cs_rows.
_cs_srow() {
  emulate -L zsh
  printf '%s\t%s\t\t%s\t%s\t\t%s\t\t%s\ts\t%s\t\t%s\t%s\t\t%s\t%s\t%s\0' "$3" "$4" "$9" "${10}" \
    "$1" "$2" "$8" "$5" "$6" "${11}" "${(D)10}" "$7"
}

# The 256 colors of cs, into the locals of its caller, as the 16 of the terminal
# theme are too saturated for a dense list.
_cs_palette() {
  text=$'\e[38;5;252m' dim=$'\e[38;5;245m' faint=$'\e[38;5;242m' bold=$'\e[1;38;5;255m' cyan=$'\e[38;5;117m'
  th=$'\e[1;38;5;244m' amber=$'\e[38;5;180m' green=$'\e[38;5;114m' rose=$'\e[38;5;210m' violet=$'\e[38;5;139m'
  band=$'\e[48;5;236m' reset=$'\e[0m'
}

# $1 cut with … or padded to $2 columns, in REPLY.
_cs_cell() {
  emulate -L zsh
  local s
  if (( ${(m)#1} > $2 )); then
    s=${(mr:$2-1:: :)1}
    # zsh keeps a wide character that crosses the cut, one column too many.
    (( ${(m)#s} < $2 )) || s=$s[1,-2]
    REPLY=${(mr:$2:: :)${:-$s…}}
  else REPLY=${(mr:$2:: :)1}; fi
}

# Saves the limits of each logged-in home to the file limits of the folder $1,
# one line for each, by name: name, percent and reset time of the session, then
# of the week, then the time the value was saved, in seconds. The home named in
# the file flag of $1 joins them, with empty values if it is not logged in. What
# is missing or has another shape is empty, and so is a value saved for another
# account: the key is internal to Claude Code, so no shape of it may stop cs. The
# file is replaced at once, as a preview may be reading it.
_cs_limits() {
  emulate -L zsh
  local h j r REPLY flag
  local -a files rows
  local prog='
    def win: if type == "object" and (.utilization | type) == "number"
      then [(.utilization | [., 0] | max | [., 100] | min | floor),
        (try (.resets_at | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) catch "")]
      else ["", ""] end;
    (.oauthAccount.accountUuid // "") as $id
    | select($id | type == "string" and . != "")
    | (.cachedUsageUtilization | try .accountUuid catch null) as $saved
    | (if $saved == null or $saved == $id then .cachedUsageUtilization else null end) as $c
    | [($c | try .utilization.five_hour catch null | win),
       ($c | try .utilization.seven_day catch null | win),
       ($c | try (.fetchedAtMs | if type == "number" then . / 1000 | floor else "" end) catch "")]
    | flatten | @tsv'
  [[ -e $1/flag ]] && flag=$(<$1/flag)
  if (( ${+commands[jq]} )); then
    for h in $HOME/.claude(|-?*)(N-/) ${(M)flag:#/*}; do
      _cs_acct $h
      files=($h/.claude.json)
      # Claude Code keeps the account of ~/.claude in ~/.claude.json.
      [[ -n $REPLY ]] || files=($HOME/.claude.json $files)
      for j in $files; do
        r=$(jq -r $prog $j 2>/dev/null) && [[ -n $r ]] || continue
        rows+=("${REPLY:-default}"$'\t'$r)
        [[ ${REPLY:-default} == "$flag" ]] && flag=
        break
      done
    done
  fi
  # A home from a flag shows even when it is not logged in.
  [[ -n $flag ]] && rows+=("$flag"$'\t\t\t\t\t')
  print -rl -- ${(ou)rows} > $1/limits.$$ && mv -f -- $1/limits.$$ $1/limits
}

# The line $1 of the limits file into the array f of the caller. A window past its
# reset counts as 0%, with no reset time.
_cs_fields() {
  zmodload zsh/datetime
  f=("${(@ps:\t:)1}")
  [[ -n $f[3] ]] && (( f[3] <= EPOCHSECONDS )) && f[2]=0 f[3]=
  [[ -n $f[5] ]] && (( f[5] <= EPOCHSECONDS )) && f[4]=0 f[5]=
  return 0
}

# The higher percent of the two windows of the limits line $1, in REPLY: empty
# when neither window has a value.
_cs_used() {
  emulate -L zsh
  local -a f
  _cs_fields "$1"
  REPLY=
  [[ -n $f[2]$f[4] ]] && REPLY=$(( ${f[2]:-0} > ${f[4]:-0} ? ${f[2]:-0} : ${f[4]:-0} ))
  return 0
}

# Writes the preselected profile to the file pick of the folder $1: the lowest
# used percent. A profile with no value comes after those with one, and the limits
# file has the names in order, so the first of equal profiles is the first by
# name. Empty with no profile. The file is replaced at once, as cs may read it
# while _cs_refresh writes it.
_cs_pick() {
  emulate -L zsh
  local line best REPLY
  local -a rows=(${(f)"$(<$1/limits)"})
  local -i low=-1
  best=${rows[1]%%$'\t'*}
  for line in $rows; do
    _cs_used "$line"
    [[ -n $REPLY ]] && (( low < 0 || REPLY < low )) || continue
    low=$REPLY best=${line%%$'\t'*}
  done
  print -r -- "$best" > $1/pick.$$ && mv -f -- $1/pick.$$ $1/pick
}

# The selected profile of the folder $1, in REPLY: its file fixed, from a flag or
# tab, else its file pick. Only tab writes the one and only _cs_pick the other, so
# a late _cs_refresh cannot undo a tab.
_cs_chosen() {
  if [[ -e $1/fixed ]]; then REPLY=$(<$1/fixed); else REPLY=$(<$1/pick); fi
}

# Prints the prompt for the folder $1 of cs, from its files and the size of fzf
# alone, so that any key can call it: the selected profile and its used percent,
# then ❯. With no profile it is the ❯ of FZF_DEFAULT_OPTS. The whole prompt takes
# at most half of L from _cs_size, so that the query has room: the percent drops
# first, and then _cs_cell cuts the name.
_cs_prompt() {
  emulate -L zsh
  local name line pct REPLY
  local -i C H L side room
  _cs_chosen $1
  name=$REPLY
  [[ -n $name ]] || { print -r -- '❯ '; return; }
  for line in ${(f)"$(<$1/limits)"}; do
    [[ $line == "$name"$'\t'* ]] || continue
    _cs_used "$line"
    pct=$REPLY
    break
  done
  name=${name/#$HOME\//\~/}
  _cs_size $1
  room=$(( L / 2 ))
  if [[ -n $pct ]] && (( ${(m)#name} + 1 + $#pct + 3 <= room )); then
    name+=" $pct"
  elif (( ${(m)#name} + 3 > room )); then
    _cs_cell "$name" $(( room > 4 ? room - 3 : 1 ))
    name=$REPLY
  fi
  print -r -- "$name ❯ "
}

# Gets live limits for each listed home of the folder $1 of cs whose saved value
# is older than 5 minutes or missing, one claude for each home at once: print
# mode /usage costs no turn or API time and saves the value that _cs_limits reads.
# No home is tried twice in 5 minutes, as the fetch can be rate limited and cs
# opens in each new herdr pane: a stamp file for each home, touched before the
# run, holds the time of the last attempt, and also stops two panes from
# fetching at once. Runs that end, or that the 20 second limit stops, then
# update the limits and the preselection; fzf redraws through its socket only
# the preview and the prompt, so its cursor, query and list stay. A failed run
# leaves the saved value, and with no curl the new one shows at the next open. cs stops this job with a TERM; the trap only sets a
# flag, so that each claude already started is in pids and is stopped too, with
# a KILL 2 seconds later for one that ignores the TERM.
_cs_refresh() {
  emulate -L zsh
  zmodload zsh/datetime zsh/zselect 2>/dev/null || return 0
  zmodload -F zsh/stat b:zstat 2>/dev/null || return 0
  local dir=$1 cache=${XDG_CACHE_HOME:-$HOME/.cache}/cs line name stamp pid sig
  local -a f mtime run pids live size
  local -i stop i deadline
  trap 'stop=1' TERM
  mkdir -p -- $cache && builtin cd -q -- $cache || return 0
  for line in ${(f)"$(<$dir/limits)"}; do
    (( stop )) && break
    f=("${(@ps:\t:)line}")
    name=$f[1]
    [[ -n $f[6] ]] && (( EPOCHSECONDS - f[6] <= 300 )) && continue
    stamp=$cache/${name//\//%}
    zstat -A mtime +mtime -- $stamp 2>/dev/null && (( EPOCHSECONDS - mtime[1] < 300 )) && continue
    touch -- $stamp || continue
    # As Enter does: the default home needs the variable unset, not set to ~/.claude.
    case $name in
      default) run=(env -u CLAUDE_CONFIG_DIR) ;;
      /*) run=(env "CLAUDE_CONFIG_DIR=$name") ;;
      *) run=(env "CLAUDE_CONFIG_DIR=$HOME/.claude-$name") ;;
    esac
    # Run from the cache folder, which has no project settings or hooks. Claude
    # Code keeps a folder in the home for each path it runs in, so the path stays.
    $run claude -p /usage --output-format json \
      --no-session-persistence --model haiku --max-turns 1 --strict-mcp-config \
      --mcp-config '{"mcpServers":{}}' --setting-sources project &
    pids+=($!)
  done
  (( $#pids )) || return 0
  deadline=$(( EPOCHSECONDS + 20 ))
  while (( $#pids && ! stop )); do
    if (( EPOCHSECONDS >= deadline )); then
      kill -${sig:-TERM} $pids 2>/dev/null
      sig=KILL
      (( deadline += 2 ))
    fi
    zselect -t 20
    live=()
    for pid in $pids; kill -0 $pid 2>/dev/null && live+=($pid)
    pids=($live)
  done
  if (( stop )); then
    kill $pids 2>/dev/null
    zselect -t 200
    kill -KILL $pids 2>/dev/null
    return 0
  fi
  $dir/ctl read-limits
  _cs_pick $dir
  # In its own process group, this job gets no resize signal: ask the terminal.
  size=(${=$(stty size < /dev/tty 2>/dev/null)})
  (( $#size == 2 )) && { FZF_LINES=$size[1]; FZF_COLUMNS=$size[2]; }
  # fzf may not listen yet, and a run can end before it starts.
  for (( i = 0; i < 25 && ! stop; i++ )); do
    curl -fs --max-time 2 --unix-socket $dir/fzf.sock \
      -d "refresh-preview+change-prompt:$(_cs_prompt $dir)" http://localhost && return 0
    zselect -t 20
  done
}

# $1 seconds in short form, in REPLY: 40m, 6h, 1d or 1d 1h.
_cs_span() {
  emulate -L zsh
  local -i s=$(( $1 < 0 ? 0 : $1 ))
  if (( s < 3600 )); then REPLY="$(( s / 60 ))m"
  elif (( s < 86400 )); then REPLY="$(( s / 3600 ))h"
  else
    REPLY="$(( s / 86400 ))d"
    (( s % 86400 < 3600 )) || REPLY+=" $(( s % 86400 / 3600 ))h"
  fi
}

# The percent $1, or - when it is empty, right-aligned to $2 columns in its
# color, in REPLY. It reads the colors of its caller.
_cs_pct() {
  emulate -L zsh
  local c=$text v="$1%"
  if [[ -z $1 ]]; then c=$dim v=-
  elif (( $1 >= 100 )); then c=$'\e[2m'$rose
  elif (( $1 >= 90 )); then c=$rose
  elif (( $1 >= 70 )); then c=$amber; fi
  printf -v REPLY '%s%*s%s' "$c" $2 "$v" "$reset"
}

# The limits block at the top of the preview, for the folder $1, fitted to the
# preview: a title line and a row for each logged-in home. A window past its
# reset counts as 0%. RESETS is the reset of the window with the higher percent,
# the week when they are equal. AGE shows when a value is older than 15 minutes.
# A preview too narrow for all columns gives up RESETS, then AGE, then SESSION,
# after the name column has shrunk to 12. Each row starts with two columns, which
# hold ▸ on the selected profile when the row kind $2 starts a new session.
_cs_limits_block() {
  emulate -L zsh
  zmodload zsh/datetime
  local text dim faint bold cyan th amber green rose violet band reset
  _cs_palette
  local line row c pick shown REPLY
  local tot='2+pm+(sw?sw+2:0)+(ww?ww+2:0)+(tw?tw+2:0)+(aw?aw+2:0)'
  local -a f ids names session week resets ages rows=(${(f)"$(<$1/limits)"})
  local -i W=${FZF_PREVIEW_COLUMNS:-80} sw=7 ww=4 tw=6 aw=3 nw=7 pw pm old i
  (( $#rows )) || return 0
  if [[ $2 == [cp] ]]; then
    _cs_chosen $1
    pick=$REPLY
  fi
  for line in $rows; do
    _cs_fields "$line"
    shown=${f[1]/#$HOME\//\~/}
    ids+=("$f[1]") names+=("$shown") session+=("$f[2]") week+=("$f[4]")
    (( ${(m)#shown} > nw )) && nw=${(m)#shown}
    # Empty fields of a window sort below every percent.
    c=$f[3]
    [[ -n $f[4] ]] && (( f[4] >= ${f[2]:--1} )) && c=$f[5]
    if [[ -n $c ]]; then _cs_span $(( c - EPOCHSECONDS )); else REPLY=-; fi
    resets+=("$REPLY")
    (( $#REPLY > tw )) && tw=$#REPLY
    if [[ -n $f[6] ]]; then
      (( EPOCHSECONDS - f[6] > 900 )) && old=1
      _cs_span $(( EPOCHSECONDS - f[6] ))
    else REPLY=-; fi
    ages+=("$REPLY")
    (( $#REPLY > aw )) && aw=$#REPLY
  done
  (( old )) || aw=0
  pm=$(( nw > 12 ? 12 : nw ))
  (( $tot > W )) && tw=0
  (( $tot > W )) && aw=0
  (( $tot > W )) && sw=0
  (( $tot > W )) && ww=0
  pw=$(( W - 2 - (sw ? sw + 2 : 0) - (ww ? ww + 2 : 0) - (tw ? tw + 2 : 0) - (aw ? aw + 2 : 0) ))
  (( pw > nw )) && pw=$nw
  (( pw < 1 )) && pw=1
  _cs_cell PROFILE $pw
  row="  $REPLY"
  (( sw )) && row+="  SESSION"
  (( ww )) && row+="  WEEK"
  (( tw )) && row+="  ${(l:tw:: :)${:-RESETS}}"
  (( aw )) && row+="  ${(l:aw:: :)${:-AGE}}"
  print -r -- "$th$row$reset"
  for (( i = 1; i <= $#names; i++ )); do
    _cs_cell "$names[i]" $pw
    c='  '
    [[ $ids[i] == "$pick" ]] && c="$cyan▸$reset "
    row="$c$text$REPLY$reset"
    if (( sw )); then _cs_pct "$session[i]" $sw; row+="  $REPLY"; fi
    if (( ww )); then _cs_pct "$week[i]" $ww; row+="  $REPLY"; fi
    (( tw )) && row+="  $dim${(l:tw:: :)resets[i]}$reset"
    (( aw )) && row+="  $dim${(l:aw:: :)ages[i]}$reset"
    print -r -- "$row"
  done
}

# The size of fzf, into C and H of the caller, and the shape that fits it, for
# the folder $1 of cs: side is 1 for the preview beside the list, in a wide and
# low window that shows a preview, and L is the width of the list, less the
# columns of pointer, marker, scrollbar and border.
_cs_size() {
  emulate -L zsh
  C=${FZF_COLUMNS:-${COLUMNS:-80}} H=${FZF_LINES:-${LINES:-24}} side=0
  (( H >= 18 && C >= 150 && C >= 3 * H )) && [[ ! -e $1/nopane ]] && side=1
  L=$(( side ? C - C * 45 / 100 - 4 : C - 3 ))
}

# The preview window for $2 rows of the folder $1, in REPLY. Under the list, it
# takes the lines that the rows and 6 lines of prompt, titles and hints leave, at
# least 35% of the window, so that the list has no empty lines. A low window, or
# one where ctrl-/ hid it, has no preview. Long lines wrap. The limits block
# stays at the top while the rest scrolls; fzf would draw the scroll position
# over its first line, so a preview with the block shows none.
_cs_pane() {
  emulate -L zsh
  local -i C H L side n
  local -a limits=(${(f)"$(<$1/limits)"})
  local top=${limits:+,noinfo,~$(( $#limits + 1 ))}
  _cs_size $1
  if (( H < 18 )) || [[ -e $1/nopane ]]; then REPLY=hidden
  elif (( side )); then REPLY=nohidden,right,45%,border-left,wrap$top
  else
    n=$(( H - 6 - ${2:-0} ))
    (( n < H * 35 / 100 )) && n=$(( H * 35 / 100 ))
    REPLY=nohidden,down,$n,border-top,wrap$top
  fi
}

# The longest key hints that fit the list: $1 is the layout, $2 the folder of cs.
# Only two or more profiles have a tab hint, as with fewer the key does nothing.
_cs_hint() {
  emulate -L zsh
  local k=$'\e[38;5;117m' t=$'\e[38;5;243m' a b c d s x y z
  local -a rows=(${(f)"$(<$2/limits)"})
  local -i C H L side
  _cs_size $2
  (( $#rows > 1 )) && x="${k}tab$t profile    " y="${k}tab$t profile  " z="${k}tab$t "
  if [[ $1 == tree ]]; then a="$k→$t open    $k←$t close    " b="$k→$t open  $k←$t close  " c="$k→←$t open  " d="$k→←$t "; fi
  for s in "$a${k}enter$t start, go to or resume claude    $x${k}ctrl-t$t open a shell there" \
    "$b${k}enter$t go  $y${k}ctrl-t$t shell" \
    "$c${k}enter$t go  $y${k}^t$t shell" \
    "$d$k⏎$t $z$k^t$t"; do
    (( ${(m)#${(S)s//$'\e['*m}} <= L )) && break
  done
  print -r -- "$s"
}

# The rows that show, as a table that fits them and the list. The
# column titles go to the title file of the folder $1, because fzf keeps the
# first header lines after a reload. A column shows only when a row has a value.
# A table that is too wide gives up, in this order: the path for the owner, the
# end of long titles and accounts, the owner, the account, the status word for
# its symbol, the age, the git column, and last more of the name. The name comes
# first, so that it stays in place when a column comes or goes. fzf searches only
# the text it shows, so what a row does not show goes past the edge of the list.
_cs_view() {
  emulate -L zsh
  local text dim faint bold cyan th amber green rose violet band reset
  _cs_palette
  local dir=$1 r s c row ind mark sc isopen hide p all ptitle=PATH REPLY
  local tot='nw+(sw?sw+2:0)+(gw?gw+2:0)+(ag?ag+2:0)+(aw?aw+2:0)+(pw?pw+2:0)'
  local -a f up rows open=(${(f)"$(<$dir/open)"})
  local -i C H L side nw sw gw ag aw pw ow n a b
  _cs_size $dir
  [[ -e $dir/all ]] && all=1
  for r in ${(0)"$(<$dir/rows)"}; do
    f=("${(@ps:\t:)r}")
    up=(${(s:|:)f[7]})
    [[ -n $all || -z ${up:|open} ]] || continue
    rows+=("$r")
    n=$(( 2 * f[9] + 2 + ${(m)#f[11]} + ( ${#f[12]} ? 3 + ${(m)#f[12]} : 0 ) ))
    (( n > nw )) && nw=$n
    [[ -n $f[13] && ( -z $f[8] || ( -z $all && ${open[(Ie)$f[6]]} -eq 0 ) ) ]] && sw=9
    n=${#${(S)f[15]//$'\e['*m}}
    (( n > gw )) && gw=$n
    (( ${#f[16]} > ag )) && ag=${#f[16]}
    (( ${#f[17]} > aw )) && aw=${#f[17]}
    (( ${#f[18]} > pw )) && pw=${#f[18]}
    n=${#${f[18]%%/*}}
    (( n > ow )) && ow=$n
  done
  # A column is at least as wide as its title.
  (( gw && gw < 3 )) && gw=3
  (( ag && ag < 3 )) && ag=3
  (( aw && aw < 4 )) && aw=4
  (( pw && pw < 4 )) && pw=4
  (( ow < 5 )) && ow=5
  if (( $tot > L )); then pw=$ow ptitle=OWNER; fi
  n=$(( L * 6 / 10 > 28 ? L * 6 / 10 : 28 ))
  (( $tot > L && nw > n )) && nw=$n
  (( $tot > L && aw > 12 )) && aw=12
  (( $tot > L )) && pw=0
  (( $tot > L )) && aw=0
  (( $tot > L && sw )) && sw=1
  (( $tot > L )) && ag=0
  (( $tot > L )) && gw=0
  (( $tot > L )) && nw=$(( L - (sw ? sw + 2 : 0) ))
  (( nw < 12 )) && nw=12
  r=${(r:nw:: :)${:-NAME}}
  (( sw )) && r+="  ${(r:sw:: :)${${sw:#1}:+STATE}}"
  (( gw )) && r+="  ${(r:gw:: :)${:-GIT}}"
  (( ag )) && r+="  ${(l:ag:: :)${:-AGE}}"
  (( aw )) && r+="  ${(r:aw:: :)${:-ACCT}}"
  (( pw )) && r+="  $ptitle"
  print -r -- "$th$r$reset" > $dir/title
  for r in $rows; do
    f=("${(@ps:\t:)r}")
    isopen=
    [[ -n $f[8] && ( -n $all || ${open[(Ie)$f[6]]} -gt 0 ) ]] && isopen=1
    n=$(( 2 * f[9] ))
    ind=${(l:n:: :)${:-}}
    mark='  '
    [[ -n $f[8] ]] && mark='▸ '
    [[ -n $isopen ]] && mark='▾ '
    p="$ind$mark$f[11]${f[12]:+ · $f[12]}"
    hide=
    (( ${(m)#p} > nw )) && hide=" $f[11] $f[12]"
    _cs_cell "$p" $nw
    a=$(( n + 2 )) b=$(( a + ${#f[11]} ))
    case $f[10] in
      r) sc=$cyan
        [[ $f[12] == (main|master) ]] && sc=$dim
        row=$dim${REPLY[1,a]}$reset$bold${REPLY[a+1,b]}$reset$sc${REPLY[b+1,-1]}$reset ;;
      b) row=$dim${REPLY[1,a]}$reset$cyan${REPLY[a+1,-1]}$reset ;;
      *) row=$text$REPLY$reset ;;
    esac
    if (( sw )); then
      s=
      [[ -z $isopen ]] && s=$f[13]
      if [[ -n $s ]]; then printf -v c '  \e[%sm%-*.*s\e[0m' "$f[14]" $sw $sw "$s"
      else printf -v c '  %*s' $sw ''; fi
      row+=$c
    fi
    if (( gw )); then
      printf -v c '  %s%*s' "$f[15]" $(( gw - ${#${(S)f[15]//$'\e['*m}} )) ''
      row+=$c
    fi
    if (( ag )); then printf -v c '  %s%*s%s' "$dim" $ag "$f[16]" "$reset"; row+=$c; fi
    if (( aw )); then _cs_cell "$f[17]" $aw; row+="  $violet$REPLY$reset"; fi
    p=$f[18]
    [[ $ptitle == OWNER ]] && p=${p%%/*}
    if (( pw )); then
      c=$faint
      (( f[9] )) || c=$dim
      row+="  $c$p$reset"
    fi
    (( pw && $#ptitle == 4 )) || hide+=" $f[18]"
    (( sw == 9 )) || hide+=" $f[13]"
    (( ${(m)#f[17]} <= aw )) || hide+=" $f[17]"
    # Past the edge by 8 columns, so that a small error in L shows none of it.
    n=$(( L + 8 - ( $tot - pw + ( pw ? ${#p} : 0 ) ) ))
    (( n > 0 )) || n=0
    printf -v row '%s%*s' "$row" $n ''
    (( f[9] )) || [[ -z $isopen ]] || row=$band${row//$reset/$reset$band}$reset
    f[3]=$row$faint$hide$reset
    printf '%s\0' "${(pj:\t:)f[1,8]}"
  done
}

# One key or event of cs, in the folder $1 of cs, whose rows file holds all
# rows, whose open file holds the id of each open row, and whose all file exists
# while there is a query. $2 view prints the rows that show. Each other $2 prints
# the fzf actions for it: for right and left, $3, $4 and $5 are the id, parents
# and has-rows fields of the row at the cursor. The arrows move in the query when
# it is not empty. Closing removes only rows below the row that stays, so its
# position holds. The preview keeps its size while you type. The titles change
# after the rows do, on the result event. ctrl-/ hides or shows the preview, and
# the list then refits as it does when the window changes size. read-limits
# saves the limits, limits prints their block for the row kind $3, and room prints
# the preview lines that the block leaves, at least 1. profile moves the selection
# $3 steps through the limits file, which is in name order, and wraps; the file
# fixed then holds it, and with fewer than two profiles it does nothing. A resize
# or a preview that grows ends with a full redraw, as fzf leaves old cells in the
# scrollbar column beside fixed preview lines; a redraw shows a blank frame, so
# no other change gets one.
# change-prompt comes last, in its colon form, so that a name can hold ) or +.
_cs_key() {
  emulate -L zsh
  local dir=$1 r target reload="reload-sync($1/ctl view)" REPLY
  local -a f acts open=(${(f)"$(<$1/open)"})
  local -i i=1
  case $2 in
    view) _cs_view $dir ;;
    read-limits) _cs_limits $dir ;;
    limits) _cs_limits_block $dir $3 ;;
    room)
      f=(${(f)"$(<$dir/limits)"})
      i=$(( ${FZF_PREVIEW_LINES:-1} - ( $#f ? $#f + 1 : 0 ) ))
      print -- $(( i > 0 ? i : 1 )) ;;
    change)
      if [[ -n $FZF_QUERY && ! -e $dir/all ]]; then : > $dir/all; print -r -- "$reload+first"
      elif [[ -z $FZF_QUERY && -e $dir/all ]]; then rm -f -- $dir/all; print -r -- "$reload+first"
      else print first; fi ;;
    result)
      r=$(<$dir/title)
      [[ $r == "$(<$dir/shown)" ]] || { print -r -- "$r" > $dir/shown; acts+=("change-header($r)"); }
      _cs_pane $dir $FZF_MATCH_COUNT
      target=$(<$dir/pane)
      if [[ -z $FZF_QUERY && $REPLY != "$target" ]]; then
        print -r -- "$REPLY" > $dir/pane
        acts+=("change-preview-window($REPLY)")
        (( ${${REPLY#*,down,}%%,*} > ${${target#*,down,}%%,*} )) && acts+=(clear-screen)
      fi
      print -r -- "${(j:+:)acts}" ;;
    preview)
      if [[ -e $dir/nopane ]]; then rm -f -- $dir/nopane; else : > $dir/nopane; fi ;&
    resize)
      _cs_pane $dir $FZF_MATCH_COUNT
      print -r -- "$REPLY" > $dir/pane
      print -r -- "change-preview-window($REPLY)+change-footer($(_cs_hint "$(<$dir/layout)" $dir))+$reload+clear-screen+change-prompt:$(_cs_prompt $dir)" ;;
    profile)
      f=(${${(f)"$(<$dir/limits)"}%%$'\t'*})
      (( $#f > 1 )) || return 0
      _cs_chosen $dir
      i=$(( (${f[(ie)$REPLY]} - 1 + $3 + $#f) % $#f + 1 ))
      print -r -- "$f[i]" > $dir/fixed.$$ && mv -f -- $dir/fixed.$$ $dir/fixed
      print -r -- "refresh-preview+change-prompt:$(_cs_prompt $dir)" ;;
    right)
      [[ -z $FZF_QUERY ]] || { print forward-char; return; }
      [[ -n $5 ]] || return 0
      if (( ${open[(Ie)$3]} )); then print down
      else print -r -- "$3" >> $dir/open; print -r -- "$reload"; fi ;;
    left)
      [[ -z $FZF_QUERY ]] || { print backward-char; return; }
      target=$3
      [[ -n $5 ]] && (( ${open[(Ie)$3]} )) || target=${4##*\|}
      [[ -n $target ]] || return 0
      for r in ${(0)"$(_cs_view $dir)"}; do
        f=("${(@ps:\t:)r}")
        [[ $f[6] == $target ]] && break
        (( i++ ))
      done
      print -rl -- ${open:#$target} > $dir/open
      print -r -- "pos($i)+$reload" ;;
  esac
}

# With --cs-key, fzf only loads the functions: see _cs_key.
[[ ${1-} == --cs-key ]] || cs "$@"
