{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "claude-opus-5-5",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactWindow": 400000,
  "autoInstallIdeExtension": false,
  "autoMemoryEnabled": false,
  "availableModels": [
    "claude-fable-5-1",
    "claude-haiku-5-5",
    "claude-opus-5-5",
    "claude-sonnet-5-5"
  ],
  "deniedMcpServers": [
    {
      "serverUrl": "https://gmailmcp.googleapis.com/mcp/*"
    },
    {
      "serverUrl": "https://calendarmcp.googleapis.com/mcp/*"
    },
    {
      "serverUrl": "https://drivemcp.googleapis.com/mcp/*"
    }
  ],
  "disableAutoMode": "disable",
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "enableArtifact": false,
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "context7@claude-plugins-official": true,
    "paper-desktop@paper": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "enforceAvailableModels": true,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "GIT_EDITOR": "true",
    "GIT_MERGE_AUTOEDIT": "no",
    "GIT_SEQUENCE_EDITOR": "true"
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "repo": "paper-design/agent-plugins",
        "source": "github"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/nested-agents.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session-plans.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/verifier-report.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "verifier"
      }
    ]
  },
  "includeGitInstructions": false,
  "model": "claude-opus-5-5[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 100000,
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(zsh -n *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "EnterPlanMode",
      "EnterWorktree",
      "Agent(isolation:remote)",
      "DesignSync",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Bash(git reset *)",
      "Bash(git -* reset *)",
      "Bash(git -* reset)",
      "Bash(git clean -*f*)",
      "Bash(git -* clean -*f*)",
      "Bash(git branch -d *)",
      "Bash(git -* branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git -* branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git -* branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git -* branch -M *)",
      "Bash(git branch -f *)",
      "Bash(git -* branch -f *)",
      "Bash(git branch --delete*)",
      "Bash(git -* branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git -* branch --move*)",
      "Bash(git branch --force*)",
      "Bash(git -* branch --force*)",
      "Bash(git branch * -d*)",
      "Bash(git -* branch * -d*)",
      "Bash(git branch * -D*)",
      "Bash(git -* branch * -D*)",
      "Bash(git branch * -m*)",
      "Bash(git -* branch * -m*)",
      "Bash(git branch * -M*)",
      "Bash(git -* branch * -M*)",
      "Bash(git branch * -f*)",
      "Bash(git -* branch * -f*)",
      "Bash(git branch -C *)",
      "Bash(git -* branch -C *)",
      "Bash(git branch * -C*)",
      "Bash(git -* branch * -C*)",
      "Bash(git branch * --delete*)",
      "Bash(git -* branch * --delete*)",
      "Bash(git branch * --move*)",
      "Bash(git -* branch * --move*)",
      "Bash(git branch * --force*)",
      "Bash(git -* branch * --force*)",
      "Bash(git tag -d*)",
      "Bash(git -* tag -d*)",
      "Bash(git tag * -d*)",
      "Bash(git -* tag * -d*)",
      "Bash(git tag -f*)",
      "Bash(git -* tag -f*)",
      "Bash(git tag * -f*)",
      "Bash(git -* tag * -f*)",
      "Bash(git tag *--delete*)",
      "Bash(git -* tag *--delete*)",
      "Bash(git tag *--force*)",
      "Bash(git -* tag *--force*)",
      "Bash(git checkout *)",
      "Bash(git -* checkout *)",
      "Bash(git checkout-index*)",
      "Bash(git -* checkout-index*)",
      "Bash(git read-tree*)",
      "Bash(git -* read-tree*)",
      "Bash(git sparse-checkout*)",
      "Bash(git -* sparse-checkout*)",
      "Bash(git restore*)",
      "Bash(git -* restore*)",
      "Bash(git stash*)",
      "Bash(git -* stash*)",
      "Bash(git switch *)",
      "Bash(git -* switch *)",
      "Bash(git bisect *)",
      "Bash(git -* bisect *)",
      "Bash(git rebase*)",
      "Bash(git -* rebase*)",
      "Bash(git pull *--rebase*)",
      "Bash(git -* pull *--rebase*)",
      "Bash(git pull -r*)",
      "Bash(git -* pull -r*)",
      "Bash(git pull * -r*)",
      "Bash(git -* pull * -r*)",
      "Bash(git * --abort)",
      "Bash(git filter-branch*)",
      "Bash(git -* filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git -* filter-repo*)",
      "Bash(git commit *--amend*)",
      "Bash(git -* commit *--amend*)",
      "Bash(git rm *)",
      "Bash(git -* rm *)",
      "Bash(git gc*)",
      "Bash(git -* gc*)",
      "Bash(git prune*)",
      "Bash(git -* prune*)",
      "Bash(git reflog expire*)",
      "Bash(git -* reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git -* reflog delete*)",
      "Bash(git reflog drop*)",
      "Bash(git -* reflog drop*)",
      "Bash(git update-ref*)",
      "Bash(git -* update-ref*)",
      "Bash(git symbolic-ref *HEAD refs/*)",
      "Bash(git -* symbolic-ref *HEAD refs/*)",
      "Bash(git symbolic-ref -d*)",
      "Bash(git -* symbolic-ref -d*)",
      "Bash(git symbolic-ref * -d*)",
      "Bash(git -* symbolic-ref * -d*)",
      "Bash(git symbolic-ref *--delete*)",
      "Bash(git -* symbolic-ref *--delete*)",
      "Bash(git worktree remove*)",
      "Bash(git -* worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(git -* worktree prune*)",
      "Bash(git worktree add *)",
      "Bash(git -* worktree add *)",
      "Bash(git worktree move*)",
      "Bash(git -* worktree move*)",
      "Bash(git push *--force*)",
      "Bash(git -* push *--force*)",
      "Bash(git push -f*)",
      "Bash(git -* push -f*)",
      "Bash(git push * -f*)",
      "Bash(git -* push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -* push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git -* push *--delete*)",
      "Bash(git push -d*)",
      "Bash(git -* push -d*)",
      "Bash(git push * -d*)",
      "Bash(git -* push * -d*)",
      "Bash(git push *--mirror*)",
      "Bash(git -* push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git -* push *--prune*)",
      "Bash(git fetch *--force*)",
      "Bash(git -* fetch *--force*)",
      "Bash(git fetch -f*)",
      "Bash(git -* fetch -f*)",
      "Bash(git fetch * -f*)",
      "Bash(git -* fetch * -f*)",
      "Bash(git fetch * +*)",
      "Bash(git -* fetch * +*)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr co *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close -d*)",
      "Bash(gh pr close * -d*)",
      "Bash(gh pr close *--delete-branch*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh release delete*)",
      "Bash(gh api *DELETE*)",
      "Bash(wt switch *)",
      "Bash(wt -* switch *)",
      "Bash(wt remove*)",
      "Bash(wt -* remove*)",
      "Bash(wt merge*)",
      "Bash(wt -* merge*)",
      "Bash(wt step*)",
      "Bash(wt -* step*)",
      "Bash(wt hook*)",
      "Bash(wt -* hook*)"
    ]
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "respectGitignore": false,
  "skillOverrides": {
    "agent-browser": "name-only",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "batch": "off",
    "bet": "off",
    "claude-in-chrome": "off",
    "dataviz": "off",
    "design": "off",
    "design-sync": "off",
    "fewer-permission-prompts": "off",
    "grilling": "user-invocable-only",
    "keybindings-help": "off",
    "loop": "off",
    "ponytail": "user-invocable-only",
    "ponytail-audit": "user-invocable-only",
    "ponytail-debt": "user-invocable-only",
    "ponytail-review": "user-invocable-only",
    "schedule": "off",
    "slides": "off",
    "thermo-nuclear-code-quality-review": "off",
    "update-config": "off",
    "workflow-authoring": "off"
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.claude/statusline-command.sh",
    "refreshInterval": 60,
    "type": "command"
  },
  "syncClaudeAiSkills": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "workflowSizeGuideline": "small"
}
