# These prefixes can run without a tool approval. AGENTS.md still controls
# whether a command is in scope; an allow rule is not the user's task request.

prefix_rule(
    pattern = ["just", ["full-check", "lint", "prettier-check", "toml-check", "gitleaks-check", "gitleaks-pending", "gitleaks-staged", "diff"]],
    decision = "allow",
    justification = "Allow the repository's documented inspection and check recipes. Read unfamiliar recipes before running them.",
    match = ["just full-check", "just diff"],
    not_match = ["just apply", "just deploy", "just brew-bundle"],
)

prefix_rule(
    pattern = ["chezmoi", ["diff", "status"]],
    decision = "allow",
    justification = "Inspect pending changes without applying them.",
    match = ["chezmoi diff", "chezmoi status"],
    not_match = ["chezmoi apply"],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "blame", "grep", "rev-parse", "rev-list", "ls-files", "ls-tree", "show-ref", "for-each-ref", "merge-base"]],
    decision = "allow",
    justification = "Read-only git inspection. AGENTS.md binds a write option such as --output.",
    match = ["git status --short", "git diff --stat", "git log --oneline -5"],
    not_match = ["git add file", "git switch main"],
)

prefix_rule(
    pattern = ["shellcheck"],
    decision = "allow",
    justification = "Static shell checking.",
    match = ["shellcheck scripts/bootstrap"],
)

prefix_rule(
    pattern = ["shfmt", "-d"],
    decision = "allow",
    justification = "Show formatter differences without writing files.",
    match = ["shfmt -d scripts/bootstrap"],
    not_match = ["shfmt -w scripts/bootstrap"],
)

prefix_rule(
    pattern = ["zsh", "-n"],
    decision = "allow",
    justification = "Parse shell syntax without executing it.",
    match = ["zsh -n dot_zshrc"],
    not_match = ["zsh -lc dot_zshrc"],
)
