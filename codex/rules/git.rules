# The git rule in code, as the deny lists of the other homes carry it; Claude's
# list in claude/settings.json is the source. Prefix rules match whole
# leading tokens only, so a git global option such as -C, a flag after a remote
# or another word, and wrappers pass; AGENTS.md binds those. Authorization for
# add, commit and plain push remains in AGENTS.md.

prefix_rule(
    pattern = ["git", ["am", "apply", "bisect", "checkout", "cherry-pick", "clone", "fetch", "gc", "init", "merge", "mv", "prune", "prune-packed", "pull", "rebase", "replace", "reset", "restore", "revert", "rm", "switch", "update-index", "update-ref"]],
    decision = "forbidden",
    justification = "The user leaves git writes other than add, commit and plain push to themselves. Give the user the exact command and continue on this checkout.",
    match = ["git reset --hard HEAD~1", "git switch main", "git checkout -b feature", "git fetch origin"],
    not_match = ["git status", "git branch -a", "git stash list", "git add file", "git commit -m message", "git push"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-ff", "-fd", "-df", "-fx", "-xf", "-fdx", "-fxd", "-dfx", "-dxf", "-xdf", "-xfd", "--force"]],
    decision = "forbidden",
    justification = "Leave deletion of untracked files to the user.",
    match = ["git clean -fd", "git clean -dfx", "git clean --force"],
    not_match = ["git clean -n", "git clean --dry-run"],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D", "-m", "-M", "-f", "-c", "-C", "--delete", "--move", "--force", "--copy"]],
    decision = "forbidden",
    justification = "Only the user creates, moves, renames or deletes branches. Give them the command.",
    match = ["git branch -D old", "git branch --copy old new"],
    not_match = ["git branch", "git branch -a", "git branch --merged main"],
)

prefix_rule(
    pattern = ["git", "stash"],
    decision = "forbidden",
    justification = "Stash writes move or discard work, and a bare git stash is one. Leave every stash command to the user, as Claude's deny list does.",
    match = ["git stash", "git stash push", "git stash pop", "git stash -u", "git stash list"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "move", "remove", "prune", "repair", "lock", "unlock"]],
    decision = "forbidden",
    justification = "Only the user changes worktrees. Continue in the session's original checkout.",
    match = ["git worktree add ../wt main", "git worktree remove ../wt"],
    not_match = ["git worktree list"],
)

prefix_rule(
    pattern = ["git", "remote", ["add", "remove", "rm", "rename", "set-url", "set-head", "prune", "update"]],
    decision = "forbidden",
    justification = "Changing remotes or fetching is a git write the user runs. Give them the command.",
    match = ["git remote set-url origin example", "git remote update"],
    not_match = ["git remote -v", "git remote get-url origin", "git remote show origin"],
)

prefix_rule(
    pattern = ["git", "config", ["set", "unset", "rename-section", "remove-section", "edit", "-e", "--add", "--unset", "--unset-all", "--replace-all", "--rename-section", "--remove-section", "--edit"]],
    decision = "forbidden",
    justification = "Only the user changes git configuration. Give them the command.",
    match = ["git config set user.name example", "git config --unset user.name"],
    not_match = ["git config get user.name", "git config --list"],
)

prefix_rule(
    pattern = ["git", "tag", ["-d", "--delete", "-f", "--force"]],
    decision = "forbidden",
    justification = "Only the user writes tags. Give them the command.",
    match = ["git tag -d old", "git tag --force latest"],
    not_match = ["git tag", "git tag --list"],
)

prefix_rule(
    pattern = ["git", "reflog", ["expire", "delete", "drop", "write"]],
    decision = "forbidden",
    justification = "Reflog writes can destroy recovery history. Leave them to the user.",
    match = ["git reflog expire --expire=now --all"],
    not_match = ["git reflog", "git reflog show"],
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "forbidden",
    justification = "Only new commits are permitted after the user asks. Give the user the amend command.",
    match = ["git commit --amend --no-edit"],
    not_match = ["git commit -m message"],
)

prefix_rule(
    pattern = ["git", "push", ["-f", "--force", "--force-with-lease", "--force-if-includes", "-d", "--delete", "--mirror", "--prune"]],
    decision = "forbidden",
    justification = "Only a plain push is permitted after the user asks. Leave remote history rewrites and ref deletion to the user.",
    match = ["git push --force origin main", "git push --delete origin old"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["wt", ["switch", "remove", "merge", "step", "hook"]],
    decision = "forbidden",
    justification = "Only the user changes branches or worktrees. Give them the command and continue in the session's original checkout.",
    match = ["wt switch feature", "wt remove", "wt merge main", "wt step commit", "wt hook pre-merge"],
    not_match = ["wt list", "wt config show"],
)

prefix_rule(
    pattern = ["gh", "pr", ["checkout", "co", "merge"]],
    decision = "forbidden",
    justification = "Checking out or merging a pull request changes a branch, which only the user does. Give them the command and continue on this checkout.",
    match = ["gh pr checkout 12", "gh pr co 12", "gh pr merge 12 --squash"],
    not_match = ["gh pr view 12", "gh pr list", "gh pr checks 12"],
)

prefix_rule(
    pattern = ["gh", "repo", "sync"],
    decision = "forbidden",
    justification = "Syncing a repository moves a branch, which only the user does. Give them the command.",
    match = ["gh repo sync", "gh repo sync owner/fork"],
    not_match = ["gh repo view", "gh repo list"],
)
