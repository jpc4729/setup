// opencode configuration — source for ~/.config/opencode/opencode.jsonc
// (install.sh copies it).
//
// ~/.opencode/ is the vendor installer's own tree (bin/, node_modules/) and is
// not a config home; opencode resolves its global config under
// ~/.config/opencode/ and probes opencode.json before opencode.jsonc, so this
// repo ships only the .jsonc half and a stray .json would silently win.
//
// Runtime state (auth.json, the session database, snapshots) lives under
// ~/.local/share/opencode and is never managed by this repo. Secrets never go
// here: `opencode auth login` owns them.
//
// Config reference: https://opencode.ai/docs/config
{
  "$schema": "https://opencode.ai/config.json",

  // Root defaults do not retain variants, so the primary agent carries the
  // high variant for new sessions, chosen for speed.
  "model": "opencode-go/glm-5.3-flash",
  "agent": {
    "build": {
      "model": "opencode-go/glm-5.3-flash",
      "variant": "high"
    }
  },

  // Homebrew owns the binary (anomalyco/tap/opencode), so the
  // built-in updater must stay out of it — a self-replaced binary under
  // /opt/homebrew is drift `brew upgrade` then fights.
  "autoupdate": false,

  // Privacy posture, mirroring codex telemetry-off and grok [features].
  // "disabled" refuses `/share` outright rather than merely not sharing by
  // default: a shared session uploads the whole transcript to opencode.ai.
  "share": "disabled",

  // Rules come from ~/.config/opencode/AGENTS.md, which opencode reads before
  // it falls back to ~/.claude/CLAUDE.md. Edit opencode/AGENTS.md.

  // One registration per host, the same posture as Cursor's mcp.json: opencode
  // ships no paper or context7 plugin, so this block is the only registration
  // for either. Both are remote streamable-HTTP, so no npx/node process per
  // session.
  //
  // `{env:VAR}` is opencode's own interpolation, resolved at config load — the
  // key stays out of this repo and comes from the environment. Without it
  // context7 still answers, on the anonymous rate limit.
  //
  // Paper answers on loopback only while Paper Desktop has a file open; when it
  // is closed the cost is one tool-fetch timeout per session (5000 ms default),
  // not a failed start.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    }
  },

  "permission": {
    // Edits go through, shell commands ask: the same posture as Claude
    // acceptEdits, codex on-request and grok `ask`. The bash denies below
    // still hold — opencode takes the LAST matching rule, and they are last.
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": {
      "*": "ask"
    },
    // The model can't load these skills, and `/name` still runs them. The
    // first five are the `user-invocable-only` entries of Claude's
    // skillOverrides; `bet` and `thermo-nuclear-code-quality-review` are its
    // `off` entries, which opencode can't hide from `/`.
    "skill": {
      "grilling": "deny",
      "ponytail": "deny",
      "ponytail-audit": "deny",
      "ponytail-debt": "deny",
      "ponytail-review": "deny",
      "bet": "deny",
      "thermo-nuclear-code-quality-review": "deny"
    },

    // This list is the whole of opencode's git enforcement; no home runs a
    // git hook. It is matched against each command of a compound line, not
    // just the line. `*` also matches nothing, so `git commit *--amend*`
    // covers `git commit --amend`.
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "shellcheck *": "allow",
      "shfmt *": "allow",
      "zsh -n *": "allow",
      "git reset*": "deny",
      "git -* reset*": "deny",
      "git clean -*f*": "deny",
      "git -* clean -*f*": "deny",
      "git branch -d *": "deny",
      "git -* branch -d *": "deny",
      "git branch -D *": "deny",
      "git -* branch -D *": "deny",
      "git branch -m *": "deny",
      "git -* branch -m *": "deny",
      "git branch -M *": "deny",
      "git -* branch -M *": "deny",
      "git branch -f *": "deny",
      "git -* branch -f *": "deny",
      "git branch --delete*": "deny",
      "git -* branch --delete*": "deny",
      "git branch --move*": "deny",
      "git -* branch --move*": "deny",
      "git branch --force*": "deny",
      "git -* branch --force*": "deny",
      "git branch * -d*": "deny",
      "git -* branch * -d*": "deny",
      "git branch * -D*": "deny",
      "git -* branch * -D*": "deny",
      "git branch * -m*": "deny",
      "git -* branch * -m*": "deny",
      "git branch * -M*": "deny",
      "git -* branch * -M*": "deny",
      "git branch * -f*": "deny",
      "git -* branch * -f*": "deny",
      "git branch -C *": "deny",
      "git -* branch -C *": "deny",
      "git branch * -C*": "deny",
      "git -* branch * -C*": "deny",
      "git branch * --delete*": "deny",
      "git -* branch * --delete*": "deny",
      "git branch * --move*": "deny",
      "git -* branch * --move*": "deny",
      "git branch * --force*": "deny",
      "git -* branch * --force*": "deny",
      "git tag -d*": "deny",
      "git -* tag -d*": "deny",
      "git tag * -d*": "deny",
      "git -* tag * -d*": "deny",
      "git tag -f*": "deny",
      "git -* tag -f*": "deny",
      "git tag * -f*": "deny",
      "git -* tag * -f*": "deny",
      "git tag *--delete*": "deny",
      "git -* tag *--delete*": "deny",
      "git tag *--force*": "deny",
      "git -* tag *--force*": "deny",
      "git checkout*": "deny",
      "git -* checkout*": "deny",
      "git read-tree*": "deny",
      "git -* read-tree*": "deny",
      "git sparse-checkout*": "deny",
      "git -* sparse-checkout*": "deny",
      "git restore*": "deny",
      "git -* restore*": "deny",
      "git stash*": "deny",
      "git -* stash*": "deny",
      "git switch*": "deny",
      "git -* switch*": "deny",
      "git bisect*": "deny",
      "git -* bisect*": "deny",
      "git rebase*": "deny",
      "git -* rebase*": "deny",
      "git pull *--rebase*": "deny",
      "git -* pull *--rebase*": "deny",
      "git pull -r*": "deny",
      "git -* pull -r*": "deny",
      "git pull * -r*": "deny",
      "git -* pull * -r*": "deny",
      "git * --abort": "deny",
      "git filter-branch*": "deny",
      "git -* filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git -* filter-repo*": "deny",
      "git commit *--amend*": "deny",
      "git -* commit *--amend*": "deny",
      "git rm*": "deny",
      "git -* rm*": "deny",
      "git gc*": "deny",
      "git -* gc*": "deny",
      "git prune*": "deny",
      "git -* prune*": "deny",
      "git reflog expire*": "deny",
      "git -* reflog expire*": "deny",
      "git reflog delete*": "deny",
      "git -* reflog delete*": "deny",
      "git reflog drop*": "deny",
      "git -* reflog drop*": "deny",
      "git update-ref*": "deny",
      "git -* update-ref*": "deny",
      "git symbolic-ref *HEAD refs/*": "deny",
      "git -* symbolic-ref *HEAD refs/*": "deny",
      "git symbolic-ref -d*": "deny",
      "git -* symbolic-ref -d*": "deny",
      "git symbolic-ref * -d*": "deny",
      "git -* symbolic-ref * -d*": "deny",
      "git symbolic-ref *--delete*": "deny",
      "git -* symbolic-ref *--delete*": "deny",
      "git worktree add*": "deny",
      "git -* worktree add*": "deny",
      "git worktree move*": "deny",
      "git -* worktree move*": "deny",
      "git worktree remove*": "deny",
      "git -* worktree remove*": "deny",
      "git worktree prune*": "deny",
      "git -* worktree prune*": "deny",
      "git push *--force*": "deny",
      "git -* push *--force*": "deny",
      "git push -f*": "deny",
      "git -* push -f*": "deny",
      "git push * -f*": "deny",
      "git -* push * -f*": "deny",
      "git push * +*": "deny",
      "git -* push * +*": "deny",
      "git push *--delete*": "deny",
      "git -* push *--delete*": "deny",
      "git push -d*": "deny",
      "git -* push -d*": "deny",
      "git push * -d*": "deny",
      "git -* push * -d*": "deny",
      "git push *--mirror*": "deny",
      "git -* push *--mirror*": "deny",
      "git push *--prune*": "deny",
      "git -* push *--prune*": "deny",
      "git push * :*": "deny",
      "git -* push * :*": "deny",
      "git fetch *--force*": "deny",
      "git -* fetch *--force*": "deny",
      "git fetch -f*": "deny",
      "git -* fetch -f*": "deny",
      "git fetch * -f*": "deny",
      "git -* fetch * -f*": "deny",
      "git fetch * +*": "deny",
      "git -* fetch * +*": "deny",
      "wt switch*": "deny",
      "wt -* switch*": "deny",
      "wt remove*": "deny",
      "wt -* remove*": "deny",
      "wt merge*": "deny",
      "wt -* merge*": "deny",
      "wt step*": "deny",
      "wt -* step*": "deny",
      "wt hook*": "deny",
      "wt -* hook*": "deny",
      "gh pr checkout*": "deny",
      "gh pr co *": "deny",
      "gh pr merge*": "deny",
      "gh pr close -d*": "deny",
      "gh pr close * -d*": "deny",
      "gh pr close *--delete-branch*": "deny",
      "gh repo sync*": "deny",
      "gh repo delete*": "deny",
      "gh repo archive*": "deny",
      "gh repo rename*": "deny",
      "gh release delete*": "deny",
      "gh api *DELETE*": "deny"
    }
  }
}
