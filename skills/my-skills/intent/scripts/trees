    'refunds/README.md': '# Refunds\n\n## Units\n\n1. `refund-shown-on-cancel.tree`\n2. `broken.tree`\n',
    'refunds/refund-shown-on-cancel.tree': CHILD,
    'refunds/broken.tree': '\n\n\n'.join(
        'refunds::%s\n// REFINES: %s\n└── when x\n   └── it should y' % pair for pair in (
            ('a', 'orders::ghost > it should x'),
            ('b', 'orders::cancel order > it should vanish'),
            ('c', 'api::POST /orders/:id/cancel > it should return 200'),
            ('d', 'api::POST /orders/:id/cancel > given the order is pending > it should return 200'),
        )) + '\n',
    'api/README.md': '# API\n\nZoom: contract.\n\n## Units\n\n1. `post-cancel.tree`\n',
    'api/post-cancel.tree': T("""
api::POST /orders/:id/cancel
// REFINES: orders::cancel order > it should show the order as "Cancelled"
├── given the order is already cancelled
│  └── it should return 200
└── given the order is pending
   └── it should return 200
      └── it should publish {OrderCancelled} once
"""),
}
AUDIT_REFINE_WANT = ['A213', 'A213', 'A214', 'A215']


def audit_fixture(files):
    import tempfile
    tmp = tempfile.mkdtemp()
    for rel, text in files.items():
        path = os.path.join(tmp, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', encoding='utf-8') as fh:
            fh.write(text)
    return tmp


def run_self_test():
    import shutil
    passed = 0
    failed = 0
    msgs = []
    for name, files, want, summary in (('audit clean', AUDIT_CLEAN, [], AUDIT_SUMMARY),
                                       ('audit broken', AUDIT_BROKEN, AUDIT_WANT, None),
                                       ('audit budget', AUDIT_BUDGET, AUDIT_BUDGET_WANT, None),
                                       ('audit split', AUDIT_SPLIT, ['A201'], AUDIT_SPLIT_SUMMARY),
                                       ('audit refine', AUDIT_REFINE, AUDIT_REFINE_WANT, None)):
        tmp = audit_fixture(files)
        F, L, S, bad = audit_home(tmp)
        shutil.rmtree(tmp)
        got = sorted(code for _, _, code, _ in F)
        if got != want or L or bad or (summary is not None and S != summary):
            failed += 1
            msgs.append('FAIL %s: codes %s, lint %s, summary %s' % (name, got, L, S))
        else:
            passed += 1
    for name, text, smoke, want, total in PATHS:
        out = leaf_lines('t', parse_text(text)[0], smoke)
        got = [int(o.split(':')[1]) for o in out if o.startswith('t:')]
        if got != want or len(out) != total:
            failed += 1
            msgs.append('FAIL paths %s: leaves %s of %d lines, want %s of %d'
                        % (name, got, len(out), want, total))
        else:
            passed += 1
    for name, text, want in ALIGNED:
        out = leaf_lines('t', parse_text(text)[0], False, aligned=True)
        got = [int(o.split(':')[1]) for o in out if o.startswith('t:')]
        if got != want:
            failed += 1
            msgs.append('FAIL paths %s: leaves %s, want %s' % (name, got, want))
        else:
            passed += 1
    out = leaf_lines('t', parse_text(CLAMP)[0], True)
    if out != [CLAMP_SMOKE]:
        failed += 1
        msgs.append('FAIL paths sentence: got %r' % out)
    else:
        passed += 1
    files = [('p', parse_text(PARENT)[0]), ('c', parse_text(CHILD)[0])]
    out = leaf_lines('p', files[0][1], False, below=refined_by(files))
    if REFINED_BY not in out:
        failed += 1
        msgs.append('FAIL paths refined by: got %r' % out)
    else:
        passed += 1
    for name, text in CLEAN:
        D = lint_text(text)
        if D:
            failed += 1
            msgs.append('FAIL %s: expected clean, got %s'
                        % (name, [(c, ln) for ln, col, c, m in D]))
        else:
            passed += 1
    for name, text, exp in PRESENT:
        D = lint_text(text)
        got = {(c, ln) for ln, col, c, m in D}
        miss = [e for e in exp if e not in got]
        if miss:
            failed += 1
            msgs.append('FAIL %s: missing %s; got %s' % (name, miss, sorted(got)))
        else:
            passed += 1
    for name, text, code in ABSENT:
        D = lint_text(text)
        got = {c for ln, col, c, m in D}
        if code in got:
            failed += 1
            msgs.append('FAIL %s: code %s should be absent; got %s'
                        % (name, code, sorted(got)))
        else:
            passed += 1
    for m in msgs:
        print(m)
    print('self-test: %d passed, %d failed' % (passed, failed))
    return 0 if failed == 0 else 1


# --------------------------------------------------------------------------- #
# CLI                                                                          #
# --------------------------------------------------------------------------- #

USAGE = '''usage: trees lint [--strict] <file|dir>...
       trees paths [--smoke] [--aligned] <file|dir>...
       trees audit [--strict] <home>
       trees --self-test
'''

FLAGS = {'lint': ('--strict',), 'paths': ('--smoke', '--aligned'), 'audit': ('--strict',)}


def collect(targets):
    files = []
    for t in targets:
        if t != '-' and os.path.isdir(t):
            for dp, dn, fn in os.walk(t):
                dn.sort()
                files.extend(os.path.join(dp, f) for f in sorted(fn) if f.endswith('.tree'))
        else:
            files.append(t)
    return files


def read(f):
    """Returns (path, text), or None after reporting the failure."""
    try:
        if f == '-':
            return '<stdin>', sys.stdin.buffer.read().decode('utf-8')
        with open(f, 'rb') as fh:
            return f, fh.read().decode('utf-8')
    except FileNotFoundError:
        sys.stderr.write('trees: %s: no such file\n' % f)
    except UnicodeDecodeError:
        sys.stderr.write('trees: %s: invalid UTF-8\n' % f)
    except OSError as e:
        sys.stderr.write('trees: %s: %s\n' % (f, e))
    return None


def main(argv):
    args = argv[1:]
    if args == ['--self-test']:
        return run_self_test()
    if not args or args[0] not in FLAGS:
        sys.stderr.write(USAGE)
        return 2
    cmd = args[0]
    opts = set()
    targets = []
    for a in args[1:]:
        if a.startswith('--'):
            if a not in FLAGS[cmd]:
                sys.stderr.write('trees: unknown option %s for %s\n' % (a, cmd))
                sys.stderr.write(USAGE)
                return 2
            opts.add(a)
        else:
            targets.append(a)
    if not targets:
        sys.stderr.write(USAGE)
        return 2

    if cmd == 'audit':
        return audit_main(targets, '--strict' in opts)

    rc = 0
    parsed = []
    for f in collect(targets):
        got = read(f)
        if got is None:
            rc = max(rc, 2)
            continue
        path, text = got
        if cmd == 'lint':
            has_err, has_warn = lint_stream(path, text)
            if has_err or ('--strict' in opts and has_warn):
                rc = max(rc, 1)
            continue
        roots, D = parse_text(text)
        if any(code[0] == 'E' for _, _, code, _ in D):
            sys.stderr.write('trees: %s: lint errors; run trees lint %s\n' % (path, path))
            rc = max(rc, 1)
            continue
        parsed.append((path, roots))
    # A refined outcome names its children, so every file is parsed before any prints.
    below = refined_by(parsed, '--aligned' in opts)
    for path, roots in parsed:
        out = leaf_lines(path, roots, '--smoke' in opts, '--aligned' in opts, below)
        if out:
            sys.stdout.write('\n'.join(out) + '\n')
    return rc


def audit_main(targets, strict):
    if len(targets) != 1 or not os.path.isdir(targets[0]):
        sys.stderr.write('trees: audit takes one home directory\n')
        sys.stderr.write(USAGE)
        return 2
    F, L, S, bad = audit_home(targets[0])
    rc = 0
    out = []
    for path, D in L:
        lines, has_err, has_warn = diag_lines(path, D)
        out.extend(lines)
        if has_err or (strict and has_warn):
            rc = 1
    for path, ln, code, msg in sorted(F):
        warn = code in WARN_CODES
        if not warn or strict:
            rc = 1
        out.append('%s:%d:1: %s[%s]: %s' % (path, ln, 'warning' if warn else 'error', code, msg))
    for path in bad:
        sys.stderr.write('trees: %s: cannot read as UTF-8\n' % path)
        rc = 2
    out.extend(S)
    if out:
        sys.stdout.write('\n'.join(out) + '\n')
    return rc


if __name__ == '__main__':
    sys.exit(main(sys.argv))
