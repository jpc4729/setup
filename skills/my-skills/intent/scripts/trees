# The refined effect names its child, one level below the effect.
REFINED_BY = '        > refined by c:1 refunds::refund shown on cancel'


AUDIT_CLEAN = {
    'README.md': '# Intent\n\n## Settings\n\n- Zoom: product.\n\n## Areas\n\n- `tickets/` — tickets.\n- `svc/` — services.\n',
    'tickets/README.md': '# Tickets\n\n## Units\n\n1. `close-ticket.tree`\n2. `merge-tickets.tree` (no tree)\n',
    'tickets/close-ticket.tree': MARKERS.replace('orders::cancel order', 'tickets::close ticket'),
    'svc/README.md': '# Services\n\nZoom: code. Depth: exhaustive.\n\n## Units\n\n1. `order-service.tree`\n',
    'svc/order-service.tree': 'OrderService::cancel\n└── when the order is paid\n   └── it should refund it\n',
