    'orders/README.md': '# Orders\n\n## Units\n\n1. `cancel-order.tree`\n2. `refund.tree` (no tree)\n3. `missing.tree`\n',
    'orders/cancel-order.tree': 'orders::cancel order\n└── when x\n   └── it should y\n',
    'orders/refund.tree': 'orders::refund\n└── when x\n   └── it should y\n',
    'orders/extra.tree': 'billing::extra\n└── when x\n   └── it should y\n',
    'orders/dup.tree': 'orders::cancel order\n└── when z\n   └── it should w\n',
    'stray/x.tree': 'stray::x\n└── when x\n   └── it should y\n',
}

AUDIT_WANT = ['A201', 'A202', 'A203', 'A203', 'A204', 'A205', 'A206', 'A207', 'A208']

