    'README.md': '# Intent\n\n## Settings\n\n- Zoom: product.\n\n## Areas\n\n'
                 '- `orders/` — orders.\n- `refunds/` — refunds.\n- `api/` — the API.\n',
    'orders/README.md': '# Orders\n\n## Units\n\n1. `cancel-order.tree`\n',
