    'backend/README.md': '# Backend\n\n## Settings\n\n- Zoom: contract.\n\n## Areas\n\n- `orders/` — orders.\n',
    'backend/orders/README.md': '# Orders\n\n## Units\n\n1. `post-cancel.tree`\n',
    # Refines an outcome in the other home: REFINES lines resolve across homes.
    'backend/orders/post-cancel.tree': 'orders::POST /orders/:id/cancel\n'
