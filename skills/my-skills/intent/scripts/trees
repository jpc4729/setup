#!/usr/bin/env python3
"""trees — lint intent trees (`.tree`) and list their leaves.

  trees lint [--strict] <file|dir>...          path:line:col: level[code]: message
  trees paths [--smoke] [--aligned] <file|dir>...  path:line: root — given …, it should …
  trees audit [--strict] <home>                path:line:col: level[code]: message
  trees --self-test

A directory means every `*.tree` under it, in sorted order. Exit 0 when clean,
1 on an error (a warning too with --strict, or a file `paths` cannot trust),
2 on a usage or read failure.

Source of truth: references/notation.md in this skill. The rules below encode
its connector, indentation, comment, multiple-tree and keyword semantics.

`paths` prints one line per leaf (a top-level `it should`), its effects below it
with `+`. A check gives each printed leaf one verdict, so `paths` refuses a file
with lint errors: a misparsed tree would silently drop or invent leaves.
`--smoke` follows the last child at every level, the happy path by convention.
`--aligned` skips a tree with a `// DRAFT:` line: checking a draft tests a guess.

A `// REFINES: <root> > … > it should …` line makes a tree a child of the
outcome it names. `paths` prints `^ refines …` under each leaf of a child, and
`> refined by path:line root` under an outcome that a tree in scope refines.

`audit` lints every unit, then checks the home's layout against the disk: the
index `## Homes` list, audited in turn, its `## Areas` list, each card's `## Units` list, `(no tree)` marks, root
prefixes, repeated roots, and REFINES lines, resolved across every home it
reads. It warns when a unit, an area or the home holds
more leaves than the budget (defaults below, or the index's `Budget:` line). It
ends with one summary line per area. The A2xx codes are listed in
references/audit.md.

Design notes / resolved ambiguities:
- Structure is validated by rebuilding the intended tree from each node's actual
  connector column (first `├`/`└`) via a column stack (O(n); per-line prefix work
  is O(depth)). is-last-child is derived from file order, then each prefix column
  is diffed against what the ancestor state requires -> exact structural codes.
- Leading/trailing stray blank lines: the spec is silent, but a well-formed
  `.tree` has no surrounding blanks, so they are flagged as E110 (error), like
  interior blanks and wrong tree separators. A single trailing newline is the
  line terminator, not a blank line, and is not flagged.
- E204 (trailing period) is applied to node labels only, never the root, so a
  root that legitimately ends in '.' is not a false positive.
- Columns are 1-based in output and counted in characters (input decoded UTF-8).
"""

import os
import re
import sys

CONN_TEE = '├'    # ├
CONN_COR = '└'    # └
PIPE = '│'        # │
DASH = '─'        # ─
ASSERT = 'it should '
REFINES = '// REFINES:'
SEP = ' > '
# references/notation.md, Wording: these words hide the outcome.
VAGUE = re.compile(r'^it should (?:(?:not|still|also|always)\s+)*'
                   r'(?:(?P<verb>handle|process|work|succeed)\b'
                   r'|be\s+(?P<part>handled|processed|worked|succeeded)\b)'
                   r'|\b(?P<adverb>correctly|properly)\b', re.IGNORECASE)
QUOTED = re.compile(r'"[^"]*"|\u201c[^\u201d]*\u201d')


def is_blank(s):
    return s.strip() == ''


def is_comment(s):
    return s.lstrip().startswith('//')


def find_connector(line):
    a = line.find(CONN_TEE)
    b = line.find(CONN_COR)
    cands = [(c, t) for c, t in ((a, CONN_TEE), (b, CONN_COR)) if c != -1]
    if not cands:
        return -1, None
    cands.sort()
    return cands[0]


class Node:
    __slots__ = ('ln', 'col', 'ctype', 'label', 'line', 'lcol',
                 'parent', 'children', 'is_last', 'draft', 'refines')

    def __init__(self, ln, col, ctype, label, line, lcol):
        self.ln = ln
        self.col = col
        self.ctype = ctype
        self.label = label
        self.line = line
        self.lcol = lcol
        self.parent = None
        self.children = []
        self.is_last = True
        self.draft = False
        self.refines = None  # (line, text) of the root's REFINES marker


def check_trailing(D, ln, s):
    r = s.rstrip()
    if r != s:
        D.append((ln, len(r) + 1, 'W303', 'trailing whitespace'))


def parse_tree(block, D):
    """Parse one tree (a content run, comments included). Returns root Node or None."""
    ridx = 0
    while ridx < len(block) and is_comment(block[ridx][1]):
        ridx += 1
    if ridx >= len(block):
        return None
    rln, rline = block[ridx]

    if rline and rline[0] in ' \t':
        D.append((rln, 1, 'E109', 'root line must start at column 0 (not indented)'))
    elif CONN_TEE in rline or CONN_COR in rline:
        D.append((rln, 1, 'E109', 'tree must begin with a root line that has no connector'))
    if '\t' in rline:
        D.append((rln, rline.find('\t') + 1, 'E108', 'tab character not allowed'))
    check_trailing(D, rln, rline)

    root = Node(rln, -3, None, rline.strip(), rline, -1)
    root.draft = any(s.strip().startswith('// DRAFT:') for _, s in block)
    refs = [(ln, s.find('//') + 1, s.strip()[len(REFINES):].strip())
            for ln, s in block if s.strip().startswith(REFINES)]
    if refs:
        ln, col, text = refs[0]
        root.refines = (ln, text)
        head, _, rest = text.partition(SEP)
        if not head or not re.search(r'(^| > )it should ', rest):
            D.append((ln, col, 'E206', "REFINES must read '// REFINES: <root> > it should …'"))
        for ln, col, _ in refs[1:]:
            D.append((ln, col, 'E206', 'a tree refines one outcome; split it into one tree per outcome'))
    parsed = []
    stack = [root]

    for (ln, s) in block[ridx + 1:]:
        if is_comment(s):
            continue
        ci, ct = find_connector(s)
        if ci == -1:
            if s and s[0] not in ' \t':
                D.append((ln, 1, 'E109',
                          'expected a node connector; found a top-level line inside a tree'))
            else:
                D.append((ln, 1, 'E107',
                          "line has no connector (expected '%s──' or '%s──')"
                          % (CONN_TEE, CONN_COR)))
            continue
        if '\t' in s:
            D.append((ln, s.find('\t') + 1, 'E108', 'tab character not allowed'))
        check_trailing(D, ln, s)

        lcol = ci + 4
        label = ''
        if len(s) >= ci + 3 and s[ci + 1] == DASH and s[ci + 2] == DASH:
            rest = s[ci + 3:]
            if rest[:1] == ' ':
                lab = rest[1:]
                if lab[:1] == ' ':
                    D.append((ln, ci + 1, 'E107', 'connector must be followed by exactly one space'))
                    label = lab.strip()
                elif lab == '':
                    D.append((ln, ci + 1, 'E107', 'connector must be followed by a non-empty label'))
                else:
                    label = lab.rstrip()
            else:
                D.append((ln, ci + 1, 'E107',
                          "connector must be '%s── ' (── then one space)" % ct))
                label = rest.strip()
        else:
            D.append((ln, ci + 1, 'E107',
                      "malformed connector; expected '── ' after '%s'" % ct))
            label = s[ci + 1:].strip()

        nd = Node(ln, ci, ct, label, s, lcol)
        while stack and stack[-1].col >= nd.col:
            stack.pop()
        parent = stack[-1] if stack else root
        nd.parent = parent
        parent.children.append(nd)
        stack.append(nd)
        parsed.append(nd)

    for p in [root] + parsed:
        for j, ch in enumerate(p.children):
            ch.is_last = (j == len(p.children) - 1)

    for nd in parsed:
        # --- indentation (E101 / E102) ---
        delta = nd.col - nd.parent.col
        if delta == 3:
            pass
        elif delta >= 6:
            D.append((nd.ln, nd.col + 1, 'E102',
                      'level jump: node is more than one level deeper than its parent '
                      '(indent 3 spaces per level)'))
        else:
            D.append((nd.ln, nd.col + 1, 'E101',
                      'bad indent: expected connector at column %d, got %d (3 spaces per level)'
                      % (nd.parent.col + 4, nd.col + 1)))

        # --- connector type vs is-last (E103) ---
        if nd.ctype == CONN_TEE and nd.is_last:
            D.append((nd.ln, nd.col + 1, 'E103',
                      "last child must use '%s──', not '%s──'"
                      % (CONN_COR, CONN_TEE)))
        elif nd.ctype == CONN_COR and not nd.is_last:
            D.append((nd.ln, nd.col + 1, 'E103',
                      "non-last child must use '%s──', not '%s──'"
                      % (CONN_TEE, CONN_COR)))

        # --- prefix columns (E104 / E105 / E106 / E108) ---
        anc = {}
        p = nd.parent
        while p is not None and p.col >= 0:
            anc[p.col] = p.is_last
            p = p.parent
        for k in range(nd.col):
            ch = nd.line[k] if k < len(nd.line) else ' '
            if ch == '\t':
                continue  # already flagged E108 once for the line
            if k in anc:
                if anc[k]:  # ancestor is a last child -> column must be blank
                    if ch == PIPE:
                        D.append((nd.ln, k + 1, 'E104',
                                  "'%s' below a last-child corner '%s'; use spaces"
                                  % (PIPE, CONN_COR)))
                    elif ch != ' ':
                        D.append((nd.ln, k + 1, 'E108',
                                  "invalid prefix character; only '%s' or space allowed" % PIPE))
                else:  # ancestor still has siblings -> column must carry a pipe
                    if ch == ' ':
                        D.append((nd.ln, k + 1, 'E105',
                                  "missing '%s'; an ancestor still has siblings below" % PIPE))
                    elif ch != PIPE:
                        D.append((nd.ln, k + 1, 'E108',
                                  "invalid prefix character; only '%s' or space allowed" % PIPE))
            else:
                if ch == PIPE:
                    D.append((nd.ln, k + 1, 'E106',
                              "'%s' does not align with any ancestor connector" % PIPE))
                elif ch != ' ':
                    D.append((nd.ln, k + 1, 'E108',
                              "invalid prefix character; only '%s' or space allowed" % PIPE))

        # --- keywords / semantics ---
        lab = nd.label
        is_assert = lab.startswith('it should ')
        is_branch = lab.startswith('given ') or lab.startswith('when ')
        if not (is_assert or is_branch):
            D.append((nd.ln, nd.lcol + 1, 'E201',
                      "node label must start with 'given ', 'when ', or 'it should '"))
        if lab.endswith('.'):
            D.append((nd.ln, nd.lcol + 1, 'E204', 'label must not end with a period'))
        vague = VAGUE.search(QUOTED.sub('""', lab)) if is_assert else None
        if vague:
            D.append((nd.ln, nd.lcol + 1, 'W305',
                      "'%s' hides the outcome; name what a reader observes"
                      % (vague.group('verb') or vague.group('part') or vague.group('adverb'))))
        if is_branch:
            q = nd.parent
            under_assert = False
            while q is not None and q.col >= 0:
                if q.label.startswith('it should '):
                    under_assert = True
                    break
                q = q.parent
            if under_assert:
                D.append((nd.ln, nd.lcol + 1, 'E202',
                          "'given'/'when' cannot appear under an 'it should' "
                          '(assertions terminate a branch)'))
            if not nd.children:
                D.append((nd.ln, nd.lcol + 1, 'E203',
                          "branch has no children; every 'given'/'when' must lead to an 'it should'"))
        if is_assert:
            cnt = 0
            q = nd.parent
            while q is not None and q.col >= 0 and q.label.startswith('it should '):
                cnt += 1
                q = q.parent
            if cnt >= 2:
                D.append((nd.ln, nd.lcol + 1, 'W304',
                          "'it should' nested more than one level under another 'it should'"))

    # --- duplicate sibling labels (W301) ---
    for p in [root] + parsed:
        seen = set()
        for ch in p.children:
            if ch.label in seen:
                D.append((ch.ln, ch.lcol + 1, 'W301',
                          'duplicate sibling label: %r' % ch.label))
            else:
                seen.add(ch.label)

    return root


def parse_text(text):
    """Parse a whole file. Returns (roots, diagnostics)."""
    D = []
    if '\r' in text:
        D.append((1, 1, 'W303', 'CRLF line endings detected; use LF'))

    lines = text.split('\n')
    if text.endswith('\n'):
        lines = lines[:-1]  # drop the terminator, not a real blank line

    classified = []
    for i, raw in enumerate(lines):
        s = raw[:-1] if raw.endswith('\r') else raw
        classified.append((i + 1, s))
    n = len(classified)

    if not any(not is_blank(s) for _, s in classified):
        return [], D  # empty / blank-only file: no trees

    # group into content runs separated by blank runs
    groups = []
    i = 0
    while i < n:
        ln, s = classified[i]
        if is_blank(s):
            first = ln
            c = 0
            while i < n and is_blank(classified[i][1]):
                c += 1
                i += 1
            groups.append(('blank', c, first))
        else:
            block = []
            while i < n and not is_blank(classified[i][1]):
                block.append(classified[i])
                i += 1
            groups.append(('content', block, None))

    trees = []
    for idx, g in enumerate(groups):
        if g[0] == 'content':
            trees.append(g[1])
        else:
            _, count, first = g
            prev_c = idx > 0 and groups[idx - 1][0] == 'content'
            next_c = idx < len(groups) - 1 and groups[idx + 1][0] == 'content'
            if prev_c and next_c:
                if count != 2:
                    D.append((first, 1, 'E110',
                              'trees must be separated by exactly two blank lines (found %d)' % count))
            elif next_c and not prev_c:
                D.append((first, 1, 'E110', 'unexpected blank line(s) before first tree'))
            elif prev_c and not next_c:
                D.append((first, 1, 'E110', 'unexpected blank line(s) after last tree'))

    roots = []
    for block in trees:
        r = parse_tree(block, D)
        if r is not None:
            roots.append(r)

    # --- container consistency across roots (E205 / W302) ---
    if roots:
        dc = [r for r in roots if '::' in r.label]
        pl = [r for r in roots if '::' not in r.label]
        if dc and pl:
            style0 = '::' in roots[0].label
            for r in roots:
                if ('::' in r.label) != style0:
                    D.append((r.ln, 1, 'W302',
                              "inconsistent root style: mix of 'area::unit' and plain roots"))
                    break
        if len(dc) >= 2:
            base = dc[0].label.split('::', 1)[0]
            for r in dc:
                c = r.label.split('::', 1)[0]
                if c != base:
                    D.append((r.ln, 1, 'E205', "root prefix mismatch: '%s' != '%s'" % (c, base)))

    return roots, D


def lint_text(text):
    return parse_text(text)[1]


def collect_leaves(node, trail, picks):
    for ch in node.children:
        if ch.label.startswith(ASSERT):
            picks.append((ch, trail + [ch.label]))
        else:
            collect_leaves(ch, trail + [ch.label], picks)


def smoke_leaf(root):
    node, trail = root, []
    while node.children:
        node = node.children[-1]
        trail.append(node.label)
        if node.label.startswith(ASSERT):
            return node, trail
    return None


def outcomes(node, out):
    """Every `it should` node under `node`, leaves and effects, in file order."""
    for ch in node.children:
        if ch.label.startswith(ASSERT):
            out.append(ch)
        outcomes(ch, out)
    return out


def names(rest, node):
    """Whether `rest` is the node's label, after labels from its path in order."""
    if rest == node.label:
        return True
    if not rest.endswith(SEP + node.label):
        return False
    left = rest[:-len(SEP + node.label)]
    p = node.parent
    while p is not None and p.col >= 0:
        if left == p.label:
            return True
        if left.endswith(SEP + p.label):
            left = left[:-len(SEP + p.label)]
        p = p.parent
    return False


PLACES = re.compile(r'\s*\[[^\]]*\]$')


def resolve(text, pool):
    """For a REFINES text over (path, root) pairs: the trees its root names, and
    the (path, root, node) outcomes it names. A root matches with or without places."""
    head, _, rest = text.partition(SEP)
    trees = [(p, r) for p, r in pool if head in (r.label, PLACES.sub('', r.label))]
    return trees, [(p, r, n) for p, r in trees for n in outcomes(r, []) if names(rest, n)]


def refined_by(files, aligned=False):
    """Maps each outcome to the `> refined by` lines of the trees in `files` that refine it."""
    pool = [(p, r) for p, roots in files for r in roots]
    below = {}
    for p, r in pool:
        if r.refines and not (aligned and r.draft):
            hits = resolve(r.refines[1], pool)[1]
            if len(hits) == 1:
                below.setdefault(hits[0][2], []).append('> refined by %s:%d %s' % (p, r.ln, r.label))
    return below


def effect_lines(node, depth, out, below):
    for e in node.children:
        out.append('%s+ %s' % ('    ' * depth, e.label))
        out.extend('    ' * (depth + 1) + s for s in below.get(e, ()))
        effect_lines(e, depth + 1, out, below)


def leaf_lines(path, roots, smoke, aligned=False, below=None):
    below = below or {}
    out = []
    for r in roots:
        if aligned and r.draft:
            continue
        if smoke:
            hit = smoke_leaf(r)
            picks = [hit] if hit else []
        else:
            picks = []
            collect_leaves(r, [], picks)
        for node, trail in picks:
            out.append('%s:%d: %s — %s' % (path, node.ln, r.label, ', '.join(trail)))
            if r.refines:
                out.append('    ^ refines %s' % r.refines[1])
            out.extend('    ' + s for s in below.get(node, ()))
            effect_lines(node, 1, out, below)
    return out


def diag_lines(path, D):
    has_err = has_warn = False
    out = []
    for ln, col, code, msg in sorted(D, key=lambda d: (d[0], d[1], d[2])):
        level = 'error' if code[0] == 'E' else 'warning'
        if level == 'error':
            has_err = True
        else:
            has_warn = True
        out.append('%s:%d:%d: %s[%s]: %s' % (path, ln, col, level, code, msg))
    return out, has_err, has_warn


def lint_stream(path, text):
    out, has_err, has_warn = diag_lines(path, lint_text(text))
    if out:
        sys.stdout.write('\n'.join(out) + '\n')
    return has_err, has_warn


# First backticked token of a list item: `- `orders/` — …` or `1. `cancel.tree``.
ITEM = re.compile(r'^\s*(?:[-*]|\d+\.)\s+`([^`]+)`')
ZOOM = re.compile(r'\bZoom:\s*`?(product|contract|code)\b')
# Leaves per unit, per area and per home: what a human aligns in about five
# minutes, one sitting and one working day. references/zoom.md explains them.
BUDGET = (12, 80, 1000)
WARN_CODES = ('A210', 'A211', 'A212')
# From coarsest to finest: a child keeps its parent's zoom or zooms in.
ZOOMS = ('product', 'contract', 'code')


def read_budget(text):
    for line in text.split('\n'):
        if 'Budget:' in line:
            nums = [int(n.replace(',', '')) for n in re.findall(r'\d[\d,]*', line.split('Budget:', 1)[1])]
            if len(nums) >= 3:
                return tuple(nums[:3])
    return BUDGET


def md_section(text, title):
    """Returns (heading line, [(line, text)]) for the `## <title>` section."""
    head, out, on = 0, [], False
    for ln, line in enumerate(text.split('\n'), 1):
        if line.startswith('## '):
            on = line[3:].strip().lower() == title
            if on:
                head = ln
            continue
        if on:
            out.append((ln, line))
    return head, out


def read_quiet(path):
    try:
        with open(path, encoding='utf-8') as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


def refine_findings(reg):
    """A213–A215 for every REFINES line, over the (path, root, zoom) of every audited tree."""
    F = []
    pool = [(p, r) for p, r, _ in reg]
    zoom_of = {r: z for _, r, z in reg}
    for path, r, zoom in reg:
        if not r.refines or SEP not in r.refines[1]:
            continue    # a malformed line is already E206
        ln, text = r.refines
        head, _, rest = text.partition(SEP)
        trees, hits = resolve(text, pool)
        if not trees:
            F.append((path, ln, 'A213', 'no tree has the root `%s`' % head))
        elif not hits:
            F.append((path, ln, 'A213', '`%s` has no outcome `%s`' % (head, rest)))
        elif len(hits) > 1:
            F.append((path, ln, 'A214', '`%s` matches %d outcomes in `%s`; add a label from its path'
                      % (rest, len(hits), head)))
        else:
            pz = zoom_of[hits[0][1]]
            if zoom in ZOOMS and pz in ZOOMS and ZOOMS.index(zoom) < ZOOMS.index(pz):
                F.append((path, ln, 'A215', 'a `%s` tree refines a `%s` outcome; a child zooms in, never out'
                          % (zoom, pz)))
    return F


def audit_home(home, reg=None):
    """Returns (findings, lint results, summary lines, unreadable paths)."""
    F, L, S, bad = [], [], [], []
    top = reg is None
    reg = [] if top else reg    # every tree of every home, for REFINES lines
    index = os.path.join(home, 'README.md')
    itext = read_quiet(index)
    if itext is None:
        F.append((index, 1, 'A200', 'the home has no readable index'))
        itext = ''
    homes = {}          # sub-home -> index line, for a root index that splits homes
    for ln, line in md_section(itext, 'homes')[1]:
        m = ITEM.match(line)
        if m and m.group(1).endswith('/') and '/' not in m.group(1)[:-1]:
            homes.setdefault(m.group(1)[:-1], ln)
    head, lines = md_section(itext, 'areas')
    head = head or 1
    listed = {}         # area -> index line
    index_units = {}    # area -> {unit: (line, no tree)}, for a home without cards
    for ln, line in lines:
        m = ITEM.match(line)
        if not m:
            continue
        tok = m.group(1)
        if tok.endswith('/') and '/' not in tok[:-1]:
            listed.setdefault(tok[:-1], ln)
        elif tok.endswith('.tree') and tok.count('/') == 1:
            a, u = tok.split('/')
            listed.setdefault(a, ln)
            index_units.setdefault(a, {})[u] = (ln, '(no tree)' in line)
    zm = ZOOM.search(itext)
    home_zoom = zm.group(1) if zm else None
    unit_max, area_max, home_max = read_budget(itext)
    total = 0

    entries = sorted(os.listdir(home))
    areas = [d for d in entries if not d.startswith('.') and os.path.isdir(os.path.join(home, d))
             and d not in homes]
    for f in entries:
        if f.endswith('.tree'):
            F.append((os.path.join(home, f), 1, 'A208', 'unit sits outside any area'))
    for a, ln in sorted(listed.items()):
        if a not in areas:
            F.append((index, ln, 'A201', 'the index lists `%s/`, which has no folder' % a))

    seen = {}           # root label -> (path, line)
    for a in areas:
        adir = os.path.join(home, a)
        files = sorted(f for f in os.listdir(adir) if f.endswith('.tree'))
        card = os.path.join(adir, 'README.md')
        ctext = read_quiet(card)
        if not files and a not in listed and ctext is None:
            continue    # a plain folder, not an area
        if files and a not in listed:
            F.append((index, head, 'A202', 'folder `%s/` holds units the index does not list' % a))
        if ctext is not None:
            src, (chead, clines) = card, md_section(ctext, 'units')
            units = {}
            for ln, line in clines:
                m = ITEM.match(line)
                if m and m.group(1).endswith('.tree'):
                    units[m.group(1).split('/')[-1]] = (ln, '(no tree)' in line)
            zm = ZOOM.search(ctext)
            zoom = zm.group(1) if zm else home_zoom
        else:
            src, chead, units, zoom = index, head, index_units.get(a), home_zoom
        # An unlisted area without a card is already A202; its units need no A203 each.
        if units is not None:
            for f in files:
                if f not in units:
                    F.append((src, chead or 1, 'A203', '`%s/%s` is on disk but not listed' % (a, f)))
            for u, (ln, no_tree) in sorted(units.items()):
                if no_tree and u in files:
                    F.append((src, ln, 'A205', '`%s` is marked (no tree) but has a file' % u))
                elif not no_tree and u not in files:
                    F.append((src, ln, 'A204', '`%s` is listed but has no file' % u))

        trees = leaves = drafts = opens = oos = 0
        for f in files:
            path = os.path.join(adir, f)
            text = read_quiet(path)
            if text is None:
                bad.append(path)
                continue
            roots, D = parse_text(text)
            if D:
                L.append((path, D))
            unit_leaves = 0
            for r in roots:
                reg.append((path, r, zoom))
                prefix = r.label.split('::', 1)[0] if '::' in r.label else None
                if zoom != 'code' and prefix != a:
                    F.append((path, r.ln, 'A206', 'root should start `%s::`' % a))
                if r.label in seen:
                    F.append((path, r.ln, 'A207', 'root repeats %s:%d' % seen[r.label]))
                else:
                    seen[r.label] = (path, r.ln)
                picks = []
                collect_leaves(r, [], picks)
                trees += 1
                unit_leaves += len(picks)
                drafts += r.draft
                # At code zoom a unit holds a whole type, so the budget binds each function tree.
                if zoom == 'code' and len(picks) > unit_max:
                    F.append((path, r.ln, 'A210', 'tree holds %d leaves; the budget is %d'
                              % (len(picks), unit_max)))
            leaves += unit_leaves
            if zoom != 'code' and unit_leaves > unit_max:
                F.append((path, 1, 'A210', 'unit holds %d leaves; the budget is %d'
                          % (unit_leaves, unit_max)))
            for line in text.split('\n'):
                t = line.strip()
                opens += t.startswith('// OPEN:')
                oos += t.startswith('// OUT OF SCOPE:')
        if leaves > area_max:
            F.append((src, chead or 1, 'A211', 'area `%s/` holds %d leaves; the budget is %d'
                      % (a, leaves, area_max)))
        total += leaves
        S.append('%s/  units %d · trees %d · leaves %d · drafts %d · open %d · out of scope %d'
                 % (a, len(files), trees, leaves, drafts, opens, oos))
    if total > home_max:
        F.append((index, 1, 'A212', 'the home holds %d leaves; the budget is %d' % (total, home_max)))
    for h, ln in sorted(homes.items()):
        hdir = os.path.join(home, h)
        if not os.path.isdir(hdir):
            F.append((index, ln, 'A201', 'the index lists home `%s/`, which has no folder' % h))
            continue
        hF, hL, hS, hbad = audit_home(hdir, reg)
        F += hF
        L += hL
        S += ['%s/%s' % (h, line) for line in hS]
        bad += hbad
    if top:
        F += refine_findings(reg)
    return F, L, S, bad


# --------------------------------------------------------------------------- #
# Self-test                                                                    #
# --------------------------------------------------------------------------- #

def T(s):
    return s[1:] if s[:1] == '\n' else s


REST = T("""
POST /api/transfers
├── given unauthenticated
│  └── it should return 401
└── given authenticated
   ├── when body is malformed
   │  └── it should return 422 with validation errors
   └── when body is valid
      ├── given sender account not found
      │  └── it should return 404
      └── given sender account exists
         ├── given insufficient balance
         │  └── it should return 409
         └── given sufficient balance
            ├── given recipient not found
            │  └── it should return 404
            └── given recipient exists
               └── it should create transfer
                  ├── it should debit sender
                  ├── it should credit recipient
                  ├── it should persist transaction record
                  ├── it should publish {TransferCompleted} event
                  └── it should return 201
""")

CLAMP = T("""
clamp
├── when value is below minimum
│  └── it should return minimum
├── when value is above maximum
│  └── it should return maximum
└── when value is within range
   └── it should return value unchanged
""")

NOTIF = T("""
NotificationService::send
├── given notifications_v2 disabled
│  └── it should send via SMTP
└── given notifications_v2 enabled
   ├── when channel is email
   │  └── it should send via SendGrid
   ├── when channel is sms
   │  ├── given phone number invalid
   │  │  └── it should throw InvalidPhoneError
   │  └── given phone number valid
   │     └── it should send via Twilio
   └── when channel is push
      ├── given no registered devices
      │  └── it should silently skip
      └── given registered devices exist
         └── it should send to all devices
            ├── it should batch per platform
            └── it should log delivery status
""")

ORDER = T("""
onOrderPlaced
├── given order ID is duplicate
│  └── it should skip processing (idempotency)
└── given order ID is new
   ├── given inventory unavailable
   │  └── it should place on backorder
   │     ├── it should persist backorder record
   │     └── it should publish {OrderBackordered} event
   └── given inventory available
      └── it should fulfill order
         ├── it should reserve inventory
         ├── it should charge payment method
         ├── it should create shipment record
         ├── it should publish {OrderFulfilled} event
         └── it should schedule delivery notification
""")

